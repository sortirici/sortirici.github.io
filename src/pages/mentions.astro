---
// src/pages/mentions.astro — Mentions légales, RGPD, éthique
// JSON-LD + maillage sémantique
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = 'https://sortirici.github.io';
const pageTitle = 'Mentions légales — RGPD, éthique et confidentialité | SortirIci';
const pageDesc = 'Mentions légales de SortirIci : éditeur, hébergement, RGPD, politique 0 cookie, 0 tracking, éthique open data, licence du code.';

// ---- JSON-LD ----
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${siteUrl}/mentions/#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Mentions légales", "item": `${siteUrl}/mentions/` },
  ],
};

const webPageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteUrl}/mentions/#webpage`,
  "name": pageTitle,
  "description": pageDesc,
  "isPartOf": { "@id": `${siteUrl}/#website` },
  "about": {
    "@type": "Thing",
    "name": "Mentions légales, RGPD et éthique de SortirIci",
    "sameAs": [
      "https://github.com/Cypriendj4/sortirici",
    ],
  },
};

const today = new Date().toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical="/mentions/"
  jsonLd={[breadcrumbLd, webPageLd]}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <div class="container">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item">
          <a href="/" class="breadcrumb__link">Accueil</a>
          <svg class="breadcrumb__sep" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </li>
        <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
          <span>Mentions légales</span>
        </li>
      </ol>
    </div>
  </nav>

  <article class="legal-content">
    <div class="container">
      <header class="legal-content__header">
        <h1 class="legal-content__title">Mentions légales</h1>
        <p class="legal-content__meta">Dernière mise à jour : {today}</p>
        <p class="legal-content__intro">
          SortirIci est un <strong>projet citoyen et open source</strong> dédié à la promotion de la culture locale
          via les données publiques ouvertes. Ce site respecte scrupuleusement le RGPD et vos données personnelles.
        </p>
      </header>

      <!-- 1. Éditeur -->
      <section class="legal-section" aria-labelledby="editeur">
        <h2 id="editeur" class="legal-section__title">1. Éditeur du site</h2>
        <div class="legal-section__body">
          <p><strong>SortirIci</strong> est un projet open source maintenu par des citoyens contributeurs.</p>
          <ul class="legal-list">
            <li><strong>Type</strong> : Projet personnel non commercial, sans personnalité morale</li>
            <li><strong>Contact</strong> : Via le dépôt GitHub officiel</li>
            <li><strong>Dépôt</strong> : <a href="https://github.com/Cypriendj4/sortirici" target="_blank" rel="noopener">github.com/Cypriendj4/sortirici</a></li>
            <li><strong>Code source</strong> : Licence MIT — librement utilisable, modifiable et redistribuable</li>
          </ul>
          <div class="legal-notice">
            <p><strong>⚠️ Aucune donnée personnelle n'est collectée, stockée ou traitée</strong> par SortirIci. Ce site est simplement un annuaire statique d'événements publics, généré à partir de données open data préexistantes.</p>
          </div>
        </div>
      </section>

      <!-- 2. Hébergement -->
      <section class="legal-section" aria-labelledby="hebergement">
        <h2 id="hebergement" class="legal-section__title">2. Hébergement</h2>
        <div class="legal-section__body">
          <ul class="legal-list">
            <li><strong>Hébergeur</strong> : GitHub Pages — GitHub, Inc.</li>
            <li><strong>Adresse</strong> : 88 Colin P. Kelly Jr. Street, San Francisco, CA 94107, États-Unis</li>
            <li><strong>Site</strong> : <a href="https://pages.github.com/" target="_blank" rel="noopener">pages.github.com</a></li>
            <li><strong>Données hébergées</strong> : Fichiers statiques HTML/CSS/JS et fichiers JSON de données publiques</li>
          </ul>
          <p class="legal-note">Aucune donnée personnelle n'est stockée sur les serveurs de GitHub dans le cadre de ce projet. Les données événementielles hébergées sont exclusivement issues de sources open data publiques.</p>
        </div>
      </section>

      <!-- 3. RGPD et Confidentialité -->
      <section class="legal-section legal-section--highlight" aria-labelledby="rgpd">
        <h2 id="rgpd" class="legal-section__title">3. RGPD et confidentialité</h2>
        <div class="legal-section__body">
          <div class="rgpd-banner">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span><strong>SortirIci est conforme RGPD par construction.</strong> Ce site ne collecte, ne stocke et ne traite <em>aucune</em> donnée personnelle.</span>
          </div>

          <h3 class="legal-subtitle">Notre politique en 5 points</h3>
          <ul class="legal-list legal-list--check">
            <li>
              <strong>0 cookie</strong> : Aucun cookie, ni technique, ni fonctionnel, ni publicitaire. Pas de cookies tiers,
              pas de cookies analytics. La seule exception est le <abbr title="Local Storage du navigateur, utilisé exclusivement pour des préférences locales non identifiantes">localStorage</abbr>
              pour la persistance des filtres (préférence locale, aucune donnée transmise).
            </li>
            <li>
              <strong>0 tracking</strong> : Aucun tracker, aucune mesure d'audience (pas de Google Analytics, pas de Matomo,
              pas de pixel). Nous ne savons pas qui consulte ce site.
            </li>
            <li>
              <strong>Aucun compte utilisateur</strong> : Pas d'inscription, pas de connexion, pas de profil. Aucune donnée
              personnelle n'est jamais demandée.
            </li>
            <li>
              <strong>0 formulaire de contact</strong> : Aucune adresse email, aucun numéro de téléphone n'est collecté via ce site.
              Les échanges se font exclusivement via les issues GitHub.
            </li>
            <li>
              <strong>Zéro PII dans les données</strong> : Les données événementielles passent par un pipeline de normalisation
              qui supprime <strong>toutes</strong> les données personnelles (emails, téléphones, noms de contacts contributeurs)
              avant toute publication.
            </li>
          </ul>

          <h3 class="legal-subtitle">Données collectées par les services tiers</h3>
          <div class="legal-table-wrap">
            <table class="legal-table">
              <thead>
                <tr>
                  <th>Service</th>
                  <th>Données</th>
                  <th>Finalité</th>
                  <th>Base légale</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>GitHub Pages</td>
                  <td>Adresse IP (logs serveur standard)</td>
                  <td>Fourniture du service d'hébergement</td>
                  <td>Intérêt légitime</td>
                </tr>
                <tr>
                  <td>Leaflet / OSM</td>
                  <td>Aucune (CDN sans cookie)</td>
                  <td>Affichage des cartes interactives</td>
                  <td>Nécessaire au service</td>
                </tr>
                <tr>
                  <td>Alpine.js CDN</td>
                  <td>Aucune (JS vanilla, pas de requête externe)</td>
                  <td>Interactivité côté client</td>
                  <td>Nécessaire au service</td>
                </tr>
                <tr>
                  <td>Sources open data</td>
                  <td>Données publiques uniquement</td>
                  <td>Affichage des événements</td>
                  <td>Mission d'intérêt public / Libre réutilisation</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 class="legal-subtitle">Vos droits RGPD</h3>
          <p>Conformément au Règlement Général sur la Protection des Données (RGPD — Règlement UE 2016/679), vous disposez des droits suivants :</p>
          <ul class="legal-list">
            <li><strong>Droit d'accès</strong> : Nous n'avons <em>aucune</em> donnée vous concernant.</li>
            <li><strong>Droit de rectification</strong> : Sans objet — aucune donnée personnelle n'est traitée.</li>
            <li><strong>Droit à l'effacement</strong> : Sans objet — aucune donnée personnelle n'est stockée.</li>
            <li><strong>Droit d'opposition</strong> : La consultation de ce site n'implique aucun traitement de données.</li>
            <li><strong>Droit à la portabilité</strong> : Sans objet — aucune donnée personnelle n'est traitée.</li>
          </ul>
          <p class="legal-note">
            Pour toute question relative à vos données, vous pouvez ouvrir une issue sur notre dépôt GitHub :
            <a href="https://github.com/Cypriendj4/sortirici/issues" target="_blank" rel="noopener">github.com/Cypriendj4/sortirici/issues</a>
          </p>
        </div>
      </section>

      <!-- 4. Données et licences -->
      <section class="legal-section" aria-labelledby="donnees">
        <h2 id="donnees" class="legal-section__title">4. Origine des données et licences</h2>
        <div class="legal-section__body">
          <p>
            Toutes les données affichées sur SortirIci proviennent de <strong>sources publiques ouvertes</strong> (open data).
            Chaque événement est accompagné de la mention de sa source, de la licence applicable et d'un lien vers la fiche originale.
          </p>
          <p>
            Les données sont réutilisées dans le cadre des licences ouvertes suivantes :
          </p>
          <ul class="legal-list">
            <li><strong>Licence Ouverte 2.0 (Etalab)</strong> — <a href="https://www.etalab.gouv.fr/licence-ouverte-open-licence/" target="_blank" rel="noopener">etalab.gouv.fr</a></li>
            <li><strong>ODbL</strong> — <a href="https://opendatacommons.org/licenses/odbl/" target="_blank" rel="noopener">opendatacommons.org</a></li>
            <li><strong>ODc-ODbL</strong> — <a href="https://opendatacommons.org/licenses/odc-by/" target="_blank" rel="noopener">opendatacommons.org</a></li>
          </ul>
          <p>
            Conformément aux obligations de ces licences, la source et la date de mise à jour sont indiquées pour chaque événement.
            Pour plus de détails, consultez la page <a href="/sources/">Sources open data</a>.
          </p>
        </div>
      </section>

      <!-- 5. Propriété intellectuelle -->
      <section class="legal-section" aria-labelledby="propriete">
        <h2 id="propriete" class="legal-section__title">5. Propriété intellectuelle</h2>
        <div class="legal-section__body">
          <ul class="legal-list">
            <li>
              <strong>Code source</strong> : Le code de SortirIci est publié sous <strong>licence MIT</strong>.
              Vous êtes libre de l'utiliser, le modifier, le distribuer, même à des fins commerciales.
            </li>
            <li>
              <strong>Contenu éditorial</strong> : Les textes originaux de SortirIci (descriptions, guides, mentions)
              sont sous <strong>licence Creative Commons BY-SA 4.0</strong>.
            </li>
            <li>
              <strong>Données événementielles</strong> : Les données proviennent de sources publiques sous licences ouvertes
              (cf. section 4). Les droits appartiennent aux producteurs de données originaux.
            </li>
            <li>
              <strong>Icônes</strong> : Les icônes utilisées sont <strong>Lucide</strong> (licence ISC — équivalent MIT).
            </li>
            <li>
              <strong>Polices</strong> : Les polices Inter (SIL OFL 1.1) et JetBrains Mono (SIL OFL 1.1) sont auto-hébergées.
            </li>
          </ul>
        </div>
      </section>

      <!-- 6. Éthique -->
      <section class="legal-section legal-section--highlight" aria-labelledby="ethique">
        <h2 id="ethique" class="legal-section__title">6. Charte éthique</h2>
        <div class="legal-section__body">
          <p>SortirIci s'engage à respecter les principes suivants :</p>
          <div class="ethics-principles">
            <article class="ethics-principle">
              <span class="ethics-principle__icon">🔒</span>
              <h3 class="ethics-principle__title">Vie privée d'abord</h3>
              <p>Zéro collecte de données personnelles. Zéro cookie. Zéro tracking. Conception « privacy by design ».</p>
            </article>
            <article class="ethics-principle">
              <span class="ethics-principle__icon">📖</span>
              <h3 class="ethics-principle__title">Transparence totale</h3>
              <p>Code source ouvert (MIT), données sourcées, licences affichées. Chaque information peut être vérifiée.</p>
            </article>
            <article class="ethics-principle">
              <span class="ethics-principle__icon">🌍</span>
              <h3 class="ethics-principle__title">Open data seulement</h3>
              <p>Utilisation exclusive de données publiques ouvertes. Aucune source propriétaire ou extractive.</p>
            </article>
            <article class="ethics-principle">
              <span class="ethics-principle__icon">♻️</span>
              <h3 class="ethics-principle__title">Éco-conception</h3>
              <p>Site statique, pas de base de données, pas de serveur applicatif. Pages légères, CSS minimal, pas de JavaScript superflu.</p>
            </article>
            <article class="ethics-principle">
              <span class="ethics-principle__icon">🤝</span>
              <h3 class="ethics-principle__title">Gratuit et accessible</h3>
              <p>100% gratuit, sans publicité, sans abonnement. Accessibilité WCAG respectée (skip link, structure sémantique).</p>
            </article>
            <article class="ethics-principle">
              <span class="ethics-principle__icon">📯</span>
              <h3 class="ethics-principle__title">Non lucratif</h3>
              <p>Projet citoyen sans but commercial. Pas de publicité, pas de sponsoring, pas de monétisation des données.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- 7. Responsabilité -->
      <section class="legal-section" aria-labelledby="responsabilite">
        <h2 id="responsabilite" class="legal-section__title">7. Responsabilité</h2>
        <div class="legal-section__body">
          <p>
            Les informations diffusées sur SortirIci proviennent de sources publiques et sont présentées à titre informatif.
            Nous ne garantissons pas l'exactitude, l'exhaustivité ou l'actualité des données. En cas d'erreur, vous pouvez :
          </p>
          <ul class="legal-list">
            <li>Consulter la <strong>source originale</strong> de l'événement (lien présent sur chaque fiche)</li>
            <li><strong>Signaler une erreur</strong> via les issues GitHub</li>
            <li>Contacter <strong>directement la source productrice</strong> des données</li>
          </ul>
          <p>
            SortirIci ne peut être tenu responsable des conséquences liées à l'utilisation des informations publiées.
            Les données sont fournies « en l'état » sans garantie d'aucune sorte.
          </p>
        </div>
      </section>

      <!-- 8. Contact -->
      <section class="legal-section" aria-labelledby="contact">
        <h2 id="contact" class="legal-section__title">8. Contact</h2>
        <div class="legal-section__body">
          <p>Toute demande relative à ces mentions légales, au RGPD ou à l'éthique du projet peut être adressée via :</p>
          <ul class="legal-list">
            <li><a href="https://github.com/Cypriendj4/sortirici/issues" target="_blank" rel="noopener">GitHub Issues</a> — pour les signalements publics</li>
            <li><a href="https://github.com/Cypriendj4/sortirici" target="_blank" rel="noopener">Dépôt GitHub</a> — pour les contributions et discussions</li>
          </ul>
        </div>
      </section>
    </div>
  </article>

  <!-- Maillage interne -->
  <nav class="legal-nav" aria-label="Navigation depuis les mentions légales">
    <div class="container">
      <div class="legal-nav__links">
        <a href="/" class="legal-nav__link">← Retour à l'accueil</a>
        <a href="/sources/" class="legal-nav__link">Sources open data</a>
        <a href="/departement/" class="legal-nav__link">Explorer les événements</a>
      </div>
    </div>
  </nav>
</BaseLayout>

<style is:global>
  /* Breadcrumb */
  .breadcrumb { background: white; border-bottom: 1px solid var(--color-neutral-200); }
  .breadcrumb__list { display: flex; align-items: center; gap: var(--space-2); list-style: none; padding: var(--space-3) 0; font-size: var(--text-sm); flex-wrap: wrap; }
  .breadcrumb__item { display: flex; align-items: center; gap: var(--space-1); }
  .breadcrumb__link { color: var(--color-neutral-500); text-decoration: none; }
  .breadcrumb__link:hover { color: var(--color-brand-brick); }
  .breadcrumb__item--current span { color: var(--color-neutral-900); font-weight: var(--font-semibold); }
  .breadcrumb__sep { color: var(--color-neutral-300); flex-shrink: 0; }

  /* Legal Content */
  .legal-content { padding: var(--space-8) 0 var(--space-12); background: linear-gradient(180deg, var(--color-neutral-50) 0%, white 30%, white 100%); }
  .legal-content__header { text-align: center; margin-bottom: var(--space-10); }
  .legal-content__title { font-size: var(--text-3xl); font-weight: var(--font-bold); margin-bottom: var(--space-2); }
  .legal-content__meta { font-size: var(--text-sm); color: var(--color-neutral-400); margin-bottom: var(--space-3); }
  .legal-content__intro { max-width: 600px; margin: 0 auto; font-size: var(--text-base); color: var(--color-neutral-600); line-height: var(--leading-relaxed); }

  /* Sections */
  .legal-section { margin-bottom: var(--space-8); }
  .legal-section--highlight {
    padding: var(--space-6);
    background: var(--color-neutral-50);
    border-radius: var(--radius-xl);
    border-left: 4px solid var(--color-brand-brick);
  }
  .legal-section--highlight .legal-section--highlight {
    background: white;
  }
  .legal-section__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    color: var(--color-neutral-900);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-neutral-200);
  }
  .legal-section__body { font-size: var(--text-base); color: var(--color-neutral-700); line-height: var(--leading-relaxed); }
  .legal-section__body p { margin-bottom: var(--space-3); max-width: 72ch; }
  .legal-section__body a { color: var(--color-brand-brick); font-weight: var(--font-medium); }
  .legal-section__body a:hover { color: var(--color-brand-brick); text-decoration: underline; }

  /* Subtitle */
  .legal-subtitle {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--color-neutral-900);
    margin-top: var(--space-5);
    margin-bottom: var(--space-3);
  }

  /* Lists */
  .legal-list {
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .legal-list li {
    padding-left: var(--space-5);
    position: relative;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }
  .legal-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-brand-brick);
    font-weight: var(--font-bold);
  }
  .legal-list--check li::before {
    content: '✓';
    color: var(--color-brand-green);
    font-weight: var(--font-bold);
  }

  /* Notice / Notes */
  .legal-notice {
    padding: var(--space-4);
    background: #FFF8E1;
    border-radius: var(--radius-lg);
    border-left: 3px solid var(--color-warning);
    font-size: var(--text-sm);
    color: #92400E;
    margin-top: var(--space-3);
  }
  .legal-note {
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
    margin-top: var(--space-2);
  }

  /* RGPD Banner */
  .rgpd-banner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-brand-green);
  }
  .rgpd-banner svg { flex-shrink: 0; }

  /* Table */
  .legal-table-wrap { overflow-x: auto; margin-bottom: var(--space-4); }
  .legal-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .legal-table th, .legal-table td {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-neutral-200);
    text-align: left;
    vertical-align: top;
  }
  .legal-table th { background: var(--color-neutral-100); font-weight: var(--font-semibold); color: var(--color-neutral-700); }
  .legal-table td { color: var(--color-neutral-600); }

  /* Ethics Principles */
  .ethics-principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .ethics-principle {
    padding: var(--space-4);
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }
  .ethics-principle__icon { font-size: var(--text-2xl); display: block; margin-bottom: var(--space-2); }
  .ethics-principle__title { font-size: var(--text-base); font-weight: var(--font-semibold); color: var(--color-neutral-900); margin-bottom: var(--space-1); }
  .ethics-principle p { font-size: var(--text-sm); color: var(--color-neutral-600); line-height: var(--leading-relaxed); }

  /* Nav */
  .legal-nav { padding: var(--space-6) 0; border-top: 1px solid var(--color-neutral-200); background: linear-gradient(180deg, white 0%, var(--color-neutral-50) 100%); }
  .legal-nav__links { display: flex; flex-wrap: wrap; gap: var(--space-4); justify-content: center; }
  .legal-nav__link { font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--color-brand-brick); text-decoration: none; }
  .legal-nav__link:hover { color: var(--color-brand-brick); text-decoration: underline; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
</style>