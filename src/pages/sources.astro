---
// src/pages/sources.astro — Liste de toutes les sources open data avec licences
// JSON-LD + maillage sémantique
import BaseLayout from '../layouts/BaseLayout.astro';

// ---- Chargement des données index ----
let globalStats = { totalEvents: 0, sources: [] as string[], lastUpdated: '' };
try {
  const { readFileSync } = await import('node:fs');
  const { join } = await import('node:path');
  const raw = readFileSync(join(process.cwd(), 'public', 'data', 'events-index.json'), 'utf-8');
  globalStats = JSON.parse(raw);
} catch {}

// ---- Sources documentées (static registry enrichi) ----
const sourceRegistry = [
  {
    id: 'openagenda',
    name: 'OpenAgenda',
    description: 'Plateforme collaborative d\'agendas culturels et citoyens. OpenAgenda permet à toute organisation (mairies, associations, lieux culturels) de publier et partager ses événements en open data.',
    url: 'https://openagenda.com',
    type: 'Plateforme collaborative',
    logo: '',
    licence: 'Licence Ouverte / ODbL',
    licenceUrl: 'https://www.etalab.gouv.fr/licence-ouverte-open-licence/',
    usage: 'Source principale de SortirIci. Les données sont récupérées via l\'API publique OpenAgenda.',
    dataTypes: 'Agendas culturels municipaux, événements associatifs, programmations de lieux',
    coverage: 'National (France)',
    updateFrequency: 'Quotidienne (via API)',
    eventCount: 0,
    status: 'active' as const,
    ethicalNote: 'OpenAgenda ne collecte pas de données personnelles. Les contributeurs peuvent choisir de partager leur email — nous les supprimons systématiquement.',
  },
  {
    id: 'ministere-culture',
    name: 'Ministère de la Culture',
    description: 'Données des festivals et manifestations culturelles labellisés par le Ministère de la Culture. Référence nationale pour les événements culturels reconnus.',
    url: 'https://www.culture.gouv.fr',
    type: 'Ministère / Institution publique',
    logo: '',
    licence: 'Licence Ouverte 2.0 (Etalab)',
    licenceUrl: 'https://www.etalab.gouv.fr/licence-ouverte-open-licence/',
    usage: 'Données des festivals labellisés importées via fichiers CSV publiés en open data.',
    dataTypes: 'Festivals labellisés, manifestations culturelles d\'intérêt national',
    coverage: 'National (France)',
    updateFrequency: 'Annuelle (saison culturelle)',
    eventCount: 0,
    status: 'active' as const,
    ethicalNote: 'Données publiques ministérielles. Les champs email et téléphone des organisateurs sont supprimés par le pipeline de normalisation.',
  },
  {
    id: 'orleans-metropole',
    name: 'Orléans Métropole',
    description: 'Portail open data d\'Orléans Métropole. Agenda des manifestations, événements culturels et sportifs sur le territoire métropolitain orléanais.',
    url: 'https://data.orleans-metropole.fr',
    type: 'Portail open data territorial',
    logo: '',
    licence: 'Licence Ouverte 2.0 (Etalab)',
    licenceUrl: 'https://www.etalab.gouv.fr/licence-ouverte-open-licence/',
    usage: 'Données des événements du Loiret (45) via API OpenDataSoft.',
    dataTypes: 'Manifestations culturelles, sportives, festives locles',
    coverage: 'Orléans Métropole (45)',
    updateFrequency: 'Quotidienne',
    eventCount: 0,
    status: 'active' as const,
    ethicalNote: 'Données publiques locales. Aucune donnée personnelle dans le jeu de données.',
  },
  {
    id: 'clermont-ferrand',
    name: 'Clermont Auvergne Métropole',
    description: 'Portail open data de Clermont Auvergne Métropole. Agenda des événements culturels et manifestations sur le territoire clermontois.',
    url: 'https://opendata.clermontmetropole.eu',
    type: 'Portail open data territorial',
    logo: '',
    licence: 'Licence Ouverte 2.0 (Etalab)',
    licenceUrl: 'https://www.etalab.gouv.fr/licence-ouverte-open-licence/',
    usage: 'Import des événements culturels du Puy-de-Dôme (63).',
    dataTypes: 'Événements culturels, manifestations locales',
    coverage: 'Clermont-Ferrand (63)',
    updateFrequency: 'Quotidienne',
    eventCount: 0,
    status: 'active' as const,
    ethicalNote: 'Données publiques territoriales.',
  },
  {
    id: 'portail-local',
    name: 'Portails open data locaux',
    description: 'Ensemble des portails open data municipaux, départementaux et régionaux référencés. Ces portails publient leurs données sous licences ouvertes (Etalab, ODbL).',
    url: 'https://www.data.gouv.fr',
    type: 'Portails ouverts territoriaux',
    logo: '',
    licence: 'Licence Ouverte 2.0 / ODbL / ODc-ODbL',
    licenceUrl: 'https://www.data.gouv.fr/fr/pages/legal/licences/',
    usage: 'Agrégation de données événementielles depuis divers portails open data locaux.',
    dataTypes: 'Agendas municipaux, événements culturels, sportifs, associatifs',
    coverage: 'Territoires couverts par des portails ouverts',
    updateFrequency: 'Variable (journalière à hebdomadaire)',
    eventCount: 0,
    status: 'active' as const,
    ethicalNote: 'Les données sont librement réutilisables dans le cadre des licences ouvertes. Notre pipeline normalise et supprime toute donnée personnelle.',
  },
];

// Compter les events par source
if (globalStats.sources) {
  for (const src of sourceRegistry) {
    src.eventCount = globalStats.sources.filter((s: string) => s.includes(src.id)).length || 0;
  }
}

const totalEvents = globalStats.totalEvents || 0;
const activeSources = sourceRegistry.filter(s => s.status === 'active');

const siteUrl = 'https://sortirici.github.io';
const pageTitle = 'Sources open data — Origine des événements | SortirIci';
const pageDesc = `Toutes les sources open data utilisées par SortirIci : ${activeSources.map(s => s.name).join(', ')}. Licences, données, éthique. Transparence totale.`;

// ---- JSON-LD ----
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${siteUrl}/sources/#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Sources open data", "item": `${siteUrl}/sources/` },
  ],
};

const datasetLd = activeSources.map((s, i) => ({
  "@context": "https://schema.org",
  "@type": "Dataset",
  "@id": `${siteUrl}/sources/#source-${s.id}`,
  "name": s.name,
  "description": s.description,
  "url": s.url,
  "license": s.licenceUrl,
  "isAccessibleForFree": true,
  "includedDataCatalog": {
    "@type": "DataCatalog",
    "name": s.name,
    "url": s.url,
  },
  "about": {
    "@type": "Thing",
    "name": s.dataTypes,
  },
}));
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical="/sources/"
  jsonLd={[breadcrumbLd, ...datasetLd]}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <div class="container">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item">
          <a href="/" class="breadcrumb__link">Accueil</a>
          <svg class="breadcrumb__sep" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </li>
        <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
          <span>Sources open data</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Header -->
  <section class="page-header">
    <div class="container">
      <h1 class="page-header__title">Nos sources open data</h1>
      <p class="page-header__desc">
        SortirIci agrège des données événementiales provenant exclusivement de <strong>sources publiques ouvertes</strong>.
        Chaque événement affiché est sourcé et sa licence est vérifiée. Aucune donnée n'est extraite sans autorisation,
        aucune source privée n'est utilisée.
      </p>
      <div class="page-header__stats">
        <div class="page-header__stat">
          <span class="page-header__stat-value">{totalEvents.toLocaleString('fr-FR')}</span>
          <span class="page-header__stat-label">Événements au total</span>
        </div>
        <div class="page-header__stat">
          <span class="page-header__stat-value">{activeSources.length}</span>
          <span class="page-header__stat-label">Sources actives</span>
        </div>
        <div class="page-header__stat">
          <span class="page-header__stat-value">FR</span>
          <span class="page-header__stat-label">Périmètre France</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Sources Grid -->
  <section class="sources-section" aria-label="Liste des sources">
    <div class="container">
      <div class="sources-grid">
        {activeSources.map(src => (
          <article class="source-card" id={`source-${src.id}`} itemscope itemtype="https://schema.org/Dataset">
            <div class="source-card__header">
              <div class="source-card__icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19a9 3 0 0 0 18 0V5"/></svg>
              </div>
              <div>
                <h2 class="source-card__title" itemprop="name">{src.name}</h2>
                <span class="source-card__type">{src.type}</span>
              </div>
              <span class={`source-card__status source-card__status--${src.status}`}>
                {src.status === 'active' ? 'Active' : 'En attente'}
              </span>
            </div>

            <p class="source-card__desc" itemprop="description">{src.description}</p>

            <dl class="source-card__details">
              <div class="source-card__detail">
                <dt>Licence</dt>
                <dd>
                  <a href={src.licenceUrl} target="_blank" rel="noopener" class="source-card__licence">
                    {src.licence}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                </dd>
              </div>
              <div class="source-card__detail">
                <dt>Site</dt>
                <dd><a href={src.url} target="_blank" rel="noopener" class="source-card__link">{src.url.replace('https://', '')}</a></dd>
              </div>
              <div class="source-card__detail">
                <dt>Couverture</dt>
                <dd>{src.coverage}</dd>
              </div>
              <div class="source-card__detail">
                <dt>Mise à jour</dt>
                <dd>{src.updateFrequency}</dd>
              </div>
            </dl>

            <div class="source-card__ethical">
              <h3 class="source-card__ethical-title">Note éthique</h3>
              <p>{src.ethicalNote}</p>
            </div>

            <a href={src.url} class="source-card__cta" target="_blank" rel="noopener">
              Consulter la source
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Section des licences -->
  <section class="licences-section" aria-label="Détail des licences">
    <div class="container">
      <h2 class="section-title">Les licences utilisées</h2>
      <p class="section-desc">Chaque source utilise une licence ouverte qui autorise la réutilisation des données, y compris à des fins commerciales, sous réserve de mention de la source.</p>

      <div class="licences-grid">
        <article class="licence-card">
          <h3 class="licence-card__title">Licence Ouverte 2.0 (Etalab)</h3>
          <p class="licence-card__desc">Licence de référence pour les données publiques françaises. Permet la reproduction, la redistribution et l'adaptation des données, même à des fins commerciales, avec la simple obligation de mentionner la source et la date de mise à jour.</p>
          <a href="https://www.etalab.gouv.fr/licence-ouverte-open-licence/" target="_blank" rel="noopener" class="licence-card__link">Voir la licence complète →</a>
        </article>
        <article class="licence-card">
          <h3 class="licence-card__title">ODbL (Open Database License)</h3>
          <p class="licence-card__desc">Licence utilisée par OpenStreetMap et certaines plateformes open data. Permet le partage et l'adaptation des bases de données, à condition de citer la source et de partager sous licence identique (copyleft).</p>
          <a href="https://opendatacommons.org/licenses/odbl/" target="_blank" rel="noopener" class="licence-card__link">Voir la licence complète →</a>
        </article>
        <article class="licence-card">
          <h3 class="licence-card__title">ODc-ODbL</h3>
          <p class="licence-card__desc">Variante de l'ODbL utilisée par certaines collectivités. Combine la dédicace au domaine public (ODC) avec les obligations de partage à l'identique (ODbL).</p>
          <a href="https://opendatacommons.org/licenses/odc-by/" target="_blank" rel="noopener" class="licence-card__link">Voir la licence complète →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Section engagement -->
  <section class="engagement-section" aria-label="Notre engagement éthique">
    <div class="container">
      <div class="engagement-content">
        <h2 class="section-title">Notre engagement</h2>
        <ul class="engagement-list">
          <li class="engagement-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span><strong>100% open data</strong> — Aucune source propriétaire, aucune extraction sans consentement</span>
          </li>
          <li class="engagement-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span><strong>0 cookie, 0 tracking</strong> — Aucune collecte de données utilisateur</span>
          </li>
          <li class="engagement-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            <span><strong>Sources citées</strong> — Chaque événement affiche clairement sa source et sa licence</span>
          </li>
          <li class="engagement-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 18a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v2H2Z"/><path d="M6 12h12"/><path d="M10 4h4"/><path d="M12 12v6"/></svg>
            <span><strong>Zéro PII</strong> — Toutes les données personnelles (email, téléphone) sont supprimées par notre pipeline</span>
          </li>
          <li class="engagement-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12h6"/><path d="M12 9v6"/><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/></svg>
            <span><strong>Transparence</strong> — Le code est open source (MIT) : <a href="https://github.com/Cypriendj4/sortirici" target="_blank" rel="noopener">github.com/Cypriendj4/sortirici</a></span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Request removal -->
  <section class="removal-section" aria-label="Demande de retrait">
    <div class="container">
      <div class="removal-box">
        <h2 class="removal-box__title">Vous êtes une source de données ?</h2>
        <p>Si vous gérez une source open data et souhaitez que vos données soient retirées de SortirIci, ou si vous avez des questions sur l'utilisation de vos données, contactez-nous via GitHub.</p>
        <a href="https://github.com/Cypriendj4/sortirici/issues" target="_blank" rel="noopener" class="removal-box__cta">
          Ouvrir une issue sur GitHub
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Maillage interne -->
  <nav class="sources-nav" aria-label="Navigation depuis les sources">
    <div class="container">
      <div class="sources-nav__links">
        <a href="/" class="sources-nav__item">← Retour à l'accueil</a>
        <a href="/mentions/" class="sources-nav__item">Mentions légales et RGPD</a>
        <a href="/departement/" class="sources-nav__item">Explorer les départements</a>
      </div>
    </div>
  </nav>
</BaseLayout>

<style is:global>
  /* Breadcrumb */
  .breadcrumb { background: white; border-bottom: 1px solid var(--color-neutral-200); }
  .breadcrumb__list { display: flex; align-items: center; gap: var(--space-2); list-style: none; padding: var(--space-3) 0; font-size: var(--text-sm); flex-wrap: wrap; }
  .breadcrumb__item { display: flex; align-items: center; gap: var(--space-1); }
  .breadcrumb__link { color: var(--color-neutral-500); text-decoration: none; }
  .breadcrumb__link:hover { color: var(--color-brand-blue); }
  .breadcrumb__item--current span { color: var(--color-neutral-900); font-weight: var(--font-semibold); }
  .breadcrumb__sep { color: var(--color-neutral-300); flex-shrink: 0; }

  /* Page Header */
  .page-header { padding: var(--space-10) 0; text-align: center; background: linear-gradient(135deg, var(--color-neutral-50) 0%, #E8F0FA 50%, var(--color-neutral-50) 100%); }
  .page-header__title { font-size: var(--text-3xl); font-weight: var(--font-bold); margin-bottom: var(--space-3); }
  .page-header__desc { max-width: 640px; margin: 0 auto var(--space-6); font-size: var(--text-base); color: var(--color-neutral-600); line-height: var(--leading-relaxed); }
  .page-header__desc strong { color: var(--color-brand-green); }
  .page-header__stats { display: flex; justify-content: center; gap: var(--space-8); flex-wrap: wrap; }
  .page-header__stat { text-align: center; }
  .page-header__stat-value { display: block; font-size: var(--text-2xl); font-weight: var(--font-bold); color: var(--color-brand-blue); }
  .page-header__stat-label { font-size: var(--text-sm); color: var(--color-neutral-500); }

  /* Sources Grid */
  .sources-section { padding: var(--space-10) 0; }
  .sources-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: var(--space-6); }
  @media (max-width: 640px) { .sources-grid { grid-template-columns: 1fr; } }

  .source-card {
    background: white;
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-soft);
    transition: transform var(--transition-default), box-shadow var(--transition-default);
    border: 1px solid var(--color-neutral-200);
  }
  .source-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-medium); }
  .source-card__header { display: flex; align-items: flex-start; gap: var(--space-3); margin-bottom: var(--space-3); }
  .source-card__icon { flex-shrink: 0; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: #E8F0FA; border-radius: var(--radius-lg); }
  .source-card__title { font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--color-neutral-900); }
  .source-card__type { font-size: var(--text-sm); color: var(--color-neutral-500); }
  .source-card__status {
    margin-left: auto;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .source-card__status--active { background: #E8F5E9; color: var(--color-brand-green); }
  .source-card__desc { font-size: var(--text-sm); color: var(--color-neutral-600); line-height: var(--leading-relaxed); margin-bottom: var(--space-4); }

  .source-card__details { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); font-size: var(--text-sm); margin-bottom: var(--space-4); }
  .source-card__detail { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-neutral-100); }
  .source-card__detail dt { font-size: var(--text-xs); font-weight: var(--font-semibold); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-neutral-400); }
  .source-card__detail dd { color: var(--color-neutral-700); margin-top: 2px; }
  .source-card__licence, .source-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-brand-blue);
    text-decoration: none;
  }
  .source-card__licence:hover, .source-card__link:hover { color: var(--color-brand-orange); text-decoration: underline; }

  .source-card__ethical {
    padding: var(--space-3);
    background: #F0FDF4;
    border-radius: var(--radius-lg);
    border-left: 3px solid var(--color-brand-green);
    margin-bottom: var(--space-4);
  }
  .source-card__ethical-title { font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--color-brand-green); margin-bottom: var(--space-1); }
  .source-card__ethical p { font-size: var(--text-sm); color: var(--color-neutral-600); line-height: var(--leading-relaxed); }

  .source-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-brand-blue);
    text-decoration: none;
  }
  .source-card__cta:hover { color: var(--color-brand-orange); text-decoration: underline; }

  /* Licences Section */
  .licences-section { padding: var(--space-10) 0; background: var(--color-neutral-50); border-top: 1px solid var(--color-neutral-200); }
  .section-title { font-size: var(--text-2xl); font-weight: var(--font-bold); margin-bottom: var(--space-2); }
  .section-desc { font-size: var(--text-base); color: var(--color-neutral-500); margin-bottom: var(--space-6); max-width: 600px; }
  .licences-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-4); }
