---
// src/pages/index.astro — Page d'accueil SortirIci v2
// Hero minimal + Carte choroplèthe SVG + Départements par volume
import BaseLayout from '../layouts/BaseLayout.astro';

// ---- Chargement des données ----
let indexData = {
  totalEvents: 0,
  totalDepartements: 0,
  departements: [] as Array<{ departement: string; nom: string; totalEvents: number; visibleEvents: number }>,
  sources: [] as string[],
};
try {
  const { readFileSync } = await import('node:fs');
  const { join } = await import('node:path');
  const raw = readFileSync(join(process.cwd(), 'public', 'data', 'events-index.json'), 'utf-8');
  indexData = JSON.parse(raw);
} catch {
  /* Pas encore de données */
}

const orderedDepts = indexData.departements
  .filter(d => d.departement !== '00')
  .sort((a, b) => b.totalEvents - a.totalEvents);

const allDepts = orderedDepts;

// Seuils de couleur pour la carte choroplèthe
function getChoroplethColor(events: number): string {
  if (events > 1000) return '#B84E23';     // brique foncé
  if (events >= 100) return '#D45D2E';     // brique moyen
  if (events >= 10) return '#E8916E';      // brique clair
  if (events >= 1) return '#B8B8C8';       // gris
  return '#EDEBE3';                         // gris clair (0)
}

// Coordonnées approximatives des départements (x,y) sur une carte SVG 460×420
const deptCoords: Record<string, {x: number; y: number}> = {
  '10': {x: 260, y: 100},  // Aube
  '16': {x: 140, y: 240},  // Charente
  '18': {x: 210, y: 170},  // Cher
  '25': {x: 340, y: 160},  // Doubs
  '27': {x: 170, y: 90},   // Eure
  '28': {x: 185, y: 100},  // Eure-et-Loir
  '33': {x: 120, y: 270},  // Gironde
  '40': {x: 115, y: 300},  // Landes
  '41': {x: 180, y: 145},  // Loir-et-Cher
  '44': {x: 110, y: 155},  // Loire-Atlantique
  '45': {x: 205, y: 130},  // Loiret
  '55': {x: 300, y: 90},   // Meuse
  '60': {x: 200, y: 80},   // Oise
  '75': {x: 200, y: 95},   // Paris
  '79': {x: 135, y: 200},  // Deux-Sèvres
  '81': {x: 195, y: 300},  // Tarn
  '85': {x: 110, y: 195},  // Vendée
  '92': {x: 198, y: 95},   // Hauts-de-Seine
};
const deptSize = 28;

const siteUrl = 'https://sortirici.github.io';
const pageTitle = "SortirIci — L'agenda local de confiance — 100% open data, 0 cookie";
const pageDesc = "Découvrez gratuitement tous les événements près de chez vous : concerts, festivals, expositions, théâtre, ateliers. Données open data, zéro cookie, zéro tracking.";

// ---- JSON-LD ----
const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "SortirIci",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.svg`,
  "description": pageDesc,
  "slogan": "L'agenda local de confiance",
  "knowsAbout": ["Événements culturels", "Open Data", "Agenda local"],
  "ethicsPolicy": `${siteUrl}/mentions/`,
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${siteUrl}/#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": siteUrl },
  ],
};
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${siteUrl}/#departements`,
  "name": "Départements couverts par SortirIci",
  "description": `Liste des ${allDepts.length} départements avec événements référencés`,
  "numberOfItems": allDepts.length,
  "itemListElement": allDepts.slice(0, 20).map((d, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": `Département ${d.departement}`,
    "url": `${siteUrl}/departement/${d.departement}/`,
  })),
};
const webSiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "name": "SortirIci",
  "url": siteUrl,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical="/"
  jsonLd={[organizationLd, breadcrumbLd, itemListLd, webSiteLd]}
>
  <!-- Hero Minimal v2 -->
  <section class="hero" aria-label="Présentation de SortirIci">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title">Sortir près de chez vous</h1>
        
        <div class="search-bar" x-data="searchApp()" role="search" aria-label="Rechercher un événement">
          <div class="search-bar__wrapper">
            <svg class="search-bar__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input
              type="search"
              class="search-bar__input"
              placeholder="Rechercher un événement, une ville, un département…"
              aria-label="Rechercher un événement, une ville ou un département"
              x-model="query"
              @input.debounce.300ms="search()"
              @keydown.down.prevent="highlightNext()"
              @keydown.up.prevent="highlightPrev()"
              @keydown.enter.prevent="goToResult()"
              @keydown.escape.prevent="close()"
            />
            <button class="search-bar__submit" aria-label="Lancer la recherche" @click="goToResult()">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-4.35-4.35"/><circle cx="11" cy="11" r="8"/></svg>
            </button>
          </div>
          <ul
            class="search-bar__results"
            x-show="results.length > 0"
            x-cloak
            role="listbox"
            aria-label="Suggestions de recherche"
          >
            <template x-for="(r, i) in results" :key="r.url">
              <li>
                <a :href="r.url" class="search-bar__result" :class="{ 'search-bar__result--active': i === highlightIndex }" role="option" :aria-selected="i === highlightIndex" x-text="r.label" @mouseenter="highlightIndex = i"></a>
              </li>
            </template>
          </ul>
        </div>

        <!-- Ligne de confiance -->
        <p class="trust-line">100% open data · 0 cookie · Sources citées</p>
      </div>
    </div>
  </section>

  <!-- Carte choroplèthe SVG v2 -->
  <section class="map-section" aria-label="Carte des événements par département">
    <div class="container">
      <h2 class="section-title">Explorez la carte</h2>
      <p class="section-desc">Visualisez les événements référencés partout en France</p>
      
      <div class="choropleth-wrapper" aria-label="Carte de France des événements par département">
        <svg viewBox="0 0 460 420" xmlns="http://www.w3.org/2000/svg" class="choropleth-map" role="img" aria-label="Carte choroplèthe de France — chaque département est coloré selon son nombre d'événements">
          <!-- Contour France simplifié -->
          <path d="M30,60 L60,20 L100,10 L140,10 L180,20 L220,15 L260,10 L300,15 L340,30 L370,50 L390,70 L400,100 L410,130 L420,160 L430,190 L440,220 L430,250 L420,280 L400,300 L380,320 L360,340 L340,360 L320,370 L300,380 L280,390 L250,400 L220,405 L190,400 L160,390 L130,380 L100,370 L80,350 L60,330 L40,300 L30,270 L20,240 L15,210 L10,180 L10,150 L15,120 L20,90 Z" fill="none" stroke="var(--color-neutral-300)" stroke-width="1.5" opacity="0.5"/>
          <!-- Corse -->
          <path d="M410,320 L420,310 L430,320 L435,340 L430,360 L420,370 L410,365 L405,345 Z" fill="none" stroke="var(--color-neutral-300)" stroke-width="1.5" opacity="0.5"/>

          <!-- Départements -->
          {allDepts.filter(d => deptCoords[d.departement]).map(d => {
            const c = deptCoords[d.departement];
            const color = getChoroplethColor(d.totalEvents);
            return (
              <a href={`/departement/${d.departement}/`}>
                <rect x={c.x - deptSize/2} y={c.y - deptSize/2} width={deptSize} height={deptSize} rx="4" fill={color} opacity="0.85" stroke="white" stroke-width="1.5">
                  <title>{d.nom || `Département ${d.departement}`} — {d.totalEvents} événements</title>
                </rect>
                <text x={c.x} y={c.y + 4} text-anchor="middle" fill="white" font-size="10" font-weight="600" font-family="system-ui,sans-serif" pointer-events="none">{d.departement}</text>
              </a>
            );
          })}
        </svg>
      </div>

      <!-- Légende -->
      <div class="choropleth-legend">
        <span class="legend-item"><span class="legend-swatch" style="background:#B84E23"></span> &gt;1000</span>
        <span class="legend-item"><span class="legend-swatch" style="background:#D45D2E"></span> 100–999</span>
        <span class="legend-item"><span class="legend-swatch" style="background:#E8916E"></span> 10–99</span>
        <span class="legend-item"><span class="legend-swatch" style="background:#B8B8C8"></span> 1–9</span>
        <span class="legend-item"><span class="legend-swatch" style="background:#EDEBE3"></span> 0</span>
      </div>
    </div>
  </section>

  <!-- Départements : un seul bloc trié par volume décroissant -->
  <section class="depts-section" id="departements-grid" aria-label="Liste des départements">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">
          Tous les départements
          {allDepts.length > 0 && <span class="section-badge">{allDepts.length}</span>}
        </h2>
        <p class="section-desc">Choisissez un département pour découvrir les événements près de chez vous</p>
      </div>

      {allDepts.length > 0 ? (
        <div class="depts-grid">
          {allDepts.map(d => {
            const size = Math.min(2.5, Math.max(1, Math.log2(d.totalEvents + 1) / 2));
            return (
              <a
                href={`/departement/${d.departement}/`}
                class="departement-card"
                aria-label={`Département ${d.nom || d.departement} — ${d.totalEvents} événements`}
                style={`--card-scale: ${size}`}
              >
                <span class="departement-card__numero" style={`font-size: clamp(1.2rem, ${size * 0.8 + 0.8}rem, 2.2rem)`}>{d.departement}</span>
                <span class="departement-card__nom">{d.nom || `Département ${d.departement}`}</span>
                <span class="departement-card__count">{d.totalEvents.toLocaleString('fr-FR')} événement{(d.totalEvents > 1) ? 's' : ''}</span>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="empty-state" role="status">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-neutral-300)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
          <h3>Les données arrivent bientôt</h3>
          <p>Les événements sont en cours de collecte. Revenez dans quelques instants !</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ====== HERO V2 (minimal) ====== */
  .hero {
    background: var(--color-neutral-50);
    padding: var(--space-8) 0 var(--space-6);
    position: relative;
  }
  .hero-content {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .hero-title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    color: var(--color-neutral-900);
    margin-bottom: var(--space-5);
    letter-spacing: -0.02em;
  }
  .trust-line {
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
    margin-top: var(--space-3);
    font-weight: var(--font-medium);
    letter-spacing: 0.02em;
  }

  /* Search */
  .search-bar {
    max-width: 520px;
    margin: 0 auto;
    position: relative;
  }
  .search-bar__wrapper {
    display: flex;
    align-items: center;
    background: white;
    border: 1.5px solid var(--color-neutral-300);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    box-shadow: var(--shadow-soft);
    transition: all var(--transition-default);
    position: relative;
  }
  .search-bar__wrapper:focus-within {
    border-color: var(--color-brand-brick);
    box-shadow: var(--shadow-medium), 0 0 0 3px rgba(212,93,46,0.1);
    outline: none;
  }
  .search-bar__icon {
    flex-shrink: 0;
    color: var(--color-neutral-400);
    margin-right: var(--space-2);
  }
  .search-bar__input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: var(--text-sm);
    padding: var(--space-1) 0;
    color: var(--color-neutral-900);
    outline: none;
    font-family: var(--font-sans);
  }
  .search-bar__input::placeholder { color: var(--color-neutral-400); }
  .search-bar__submit {
    flex-shrink: 0;
    background: var(--color-brand-brick);
    color: white;
    border: none;
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    transition: background var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }
  .search-bar__submit:hover { background: #B84E23; }
  .search-bar__submit svg { margin-right: 4px; }
  .search-bar__results {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    list-style: none;
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-strong);
    border: 1px solid var(--color-neutral-200);
    z-index: 100;
    max-height: 320px;
    overflow-y: auto;
  }
  .search-bar__result {
    display: block;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-neutral-700);
    text-decoration: none;
    transition: background var(--transition-fast);
    border-bottom: 1px solid var(--color-neutral-100);
  }
  .search-bar__result:last-child { border-bottom: none; }
  .search-bar__result:hover,
  .search-bar__result--active { background: var(--color-neutral-100); color: var(--color-brand-brick); }

  /* ====== CARTE CHOROPLÈTHE SVG ====== */
  .map-section { padding: var(--space-8) 0 var(--space-6); background: var(--color-neutral-50); }
  .section-title {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    color: var(--color-neutral-900);
    margin-bottom: var(--space-2);
    text-align: center;
    font-size: var(--text-3xl);
  }
  .section-desc {
    font-size: var(--text-base);
    color: var(--color-neutral-500);
    text-align: center;
    margin-bottom: var(--space-6);
  }
  .choropleth-wrapper {
    max-width: 520px;
    margin: 0 auto;
    background: white;
    border-radius: var(--radius-xl);
    padding: var(--space-4);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-neutral-100);
  }
  .choropleth-map {
    width: 100%;
    height: auto;
    display: block;
  }
  .choropleth-map rect { transition: opacity var(--transition-fast); cursor: pointer; }
  .choropleth-map rect:hover { opacity: 1 !important; stroke: var(--color-neutral-900) !important; stroke-width: 2.5 !important; }
  .choropleth-legend {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-neutral-500);
  }
  .legend-item { display: inline-flex; align-items: center; gap: var(--space-1); }
  .legend-swatch { display: inline-block; width: 12px; height: 12px; border-radius: 2px; border: 1px solid rgba(0,0,0,0.1); }

  /* ====== DÉPARTEMENTS (un seul bloc, tailles variables) ====== */
  .depts-section { padding: var(--space-10) 0; background: var(--color-neutral-50); }
  .section-header { text-align: center; margin-bottom: var(--space-8); }
  .section-badge {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    background: var(--color-brand-brick);
    color: white;
    padding: 2px var(--space-3);
    border-radius: var(--radius-full);
    vertical-align: middle;
    margin-left: var(--space-2);
  }
  .depts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-3);
  }
  .departement-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-3);
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    transition: all var(--transition-default);
    text-decoration: none;
    border: 1.5px solid transparent;
  }
  .departement-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-medium);
    border-color: var(--color-brand-brick);
  }
  .departement-card:focus-visible {
    outline: 2px solid var(--color-brand-brick);
    outline-offset: 2px;
  }
  .departement-card__numero {
    font-weight: var(--font-bold);
    color: var(--color-brand-brick);
    line-height: 1;
    font-family: var(--font-sans);
  }
  .departement-card__nom {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-neutral-900);
    text-align: center;
    line-height: var(--leading-tight);
  }
  .departement-card__count {
    font-size: 0.65rem;
    color: var(--color-brand-muted);
  }

  /* ====== EMPTY STATE ====== */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-12) var(--space-4);
    text-align: center;
  }
  .empty-state h3 { font-size: var(--text-xl); font-weight: var(--font-semibold); color: var(--color-neutral-700); font-family: var(--font-sans); }
  .empty-state p { font-size: var(--text-base); color: var(--color-neutral-500); max-width: 400px; line-height: var(--leading-relaxed); }

  /* ====== SKELETON ====== */
  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  .skeleton {
    background: linear-gradient(90deg, var(--color-neutral-100) 25%, var(--color-neutral-200) 50%, var(--color-neutral-100) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s ease-in-out infinite;
  }
  .skeleton--card { height: 180px; border-radius: var(--radius-xl); }
  .skeleton--text { height: 1rem; border-radius: var(--radius-md); width: 80%; }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .depts-grid > .departement-card:nth-child(1) { animation: fadeInUp var(--transition-slow) ease-out 50ms both; }
  .depts-grid > .departement-card:nth-child(2) { animation: fadeInUp var(--transition-slow) ease-out 100ms both; }
  .depts-grid > .departement-card:nth-child(3) { animation: fadeInUp var(--transition-slow) ease-out 150ms both; }
  .depts-grid > .departement-card:nth-child(4) { animation: fadeInUp var(--transition-slow) ease-out 200ms both; }
  .depts-grid > .departement-card:nth-child(5) { animation: fadeInUp var(--transition-slow) ease-out 250ms both; }
  .depts-grid > .departement-card:nth-child(6) { animation: fadeInUp var(--transition-slow) ease-out 300ms both; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
  [x-cloak] { display: none !important; }
</style>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('searchApp', () => ({
      query: '',
      results: [],
      highlightIndex: -1,
      async search() {
        if (this.query.length < 2) { this.results = []; this.highlightIndex = -1; return; }
        const q = this.query.toLowerCase();
        const res = [];
        try {
          const r = await fetch('/data/events-index.json');
          const idx = await r.json();
          for (const d of idx.departements || []) {
            const label = `${d.nom || `Département ${d.departement}`} (${d.departement})`;
            if (label.toLowerCase().includes(q)) {
              res.push({ label: `📍 ${label} — ${d.totalEvents} événements`, url: `/departement/${d.departement}/` });
            }
          }
        } catch {}
        const staticSuggestions = [
          { label: '🎵 Concerts', url: '/departement/' },
          { label: '🎭 Théâtre', url: '/departement/' },
          { label: '🖼️ Expositions', url: '/departement/' },
          { label: '🎪 Festivals', url: '/departement/' },
          { label: '👶 Enfants', url: '/departement/' },
        ];
        for (const s of staticSuggestions) {
          if (s.label.toLowerCase().includes(q)) res.push(s);
        }
        this.results = res.slice(0, 8);
        this.highlightIndex = -1;
      },
      highlightNext() {
        if (this.results.length === 0) return;
        this.highlightIndex = Math.min(this.highlightIndex + 1, this.results.length - 1);
      },
      highlightPrev() {
        if (this.results.length === 0) return;
        this.highlightIndex = Math.max(this.highlightIndex - 1, -1);
      },
      goToResult() {
        if (this.highlightIndex >= 0 && this.results[this.highlightIndex]) {
          window.location.href = this.results[this.highlightIndex].url;
        } else if (this.results.length === 1) {
          window.location.href = this.results[0].url;
        }
      },
      close() { this.results = []; this.highlightIndex = -1; },
    }));
  });
</script>