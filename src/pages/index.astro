  .empty-state h3 { font-size: var(--text-xl); font-weight: var(--font-semibold); color: var(--color-neutral-700); font-family: var(--font-sans); }
  .empty-state p { font-size: var(--text-base); color: var(--color-neutral-500); max-width: 400px; line-height: var(--leading-relaxed); }

  /* ====== SKELETON ====== */
  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  .skeleton {
    background: linear-gradient(90deg, var(--color-neutral-100) 25%, var(--color-neutral-200) 50%, var(--color-neutral-100) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s ease-in-out infinite;
  }
  .skeleton--card { height: 180px; border-radius: var(--radius-xl); }
  .skeleton--text { height: 1rem; border-radius: var(--radius-md); width: 80%; }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .depts-grid > .departement-card:nth-child(1) { animation: fadeInUp var(--transition-slow) ease-out 50ms both; }
  .depts-grid > .departement-card:nth-child(2) { animation: fadeInUp var(--transition-slow) ease-out 100ms both; }
  .depts-grid > .departement-card:nth-child(3) { animation: fadeInUp var(--transition-slow) ease-out 150ms both; }
  .depts-grid > .departement-card:nth-child(4) { animation: fadeInUp var(--transition-slow) ease-out 200ms both; }
  .depts-grid > .departement-card:nth-child(5) { animation: fadeInUp var(--transition-slow) ease-out 250ms both; }
  .depts-grid > .departement-card:nth-child(6) { animation: fadeInUp var(--transition-slow) ease-out 300ms both; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
  [x-cloak] { display: none !important; }

  /* ====== BREADCRUMB ====== */
  .breadcrumb { background: white; border-bottom: 1px solid var(--color-neutral-100); }
  .breadcrumb__list { display: flex; align-items: center; gap: var(--space-2); list-style: none; padding: var(--space-3) 0; font-size: var(--text-sm); flex-wrap: wrap; }
  .breadcrumb__item { display: flex; align-items: center; gap: var(--space-1); }
  .breadcrumb__item--current span { color: var(--color-neutral-900); font-weight: var(--font-semibold); }

  /* ====== SEO CONTENT ====== */
  .seo-content { padding: var(--space-10) 0; background: white; border-top: 1px solid var(--color-neutral-100); }
  .seo-content__grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-8); margin-bottom: var(--space-8); }
  @media (max-width: 768px) { .seo-content__grid { grid-template-columns: 1fr; } }
  .seo-content__title { font-size: var(--text-2xl); font-family: var(--font-serif); font-weight: var(--font-normal); margin-bottom: var(--space-4); color: var(--color-neutral-900); }
  .seo-content__para { font-size: var(--text-base); line-height: var(--leading-relaxed); color: var(--color-neutral-700); margin-bottom: var(--space-3); max-width: 72ch; }
  .seo-content__para strong { color: var(--color-brand-brick); }
  .seo-content__lists { display: flex; flex-direction: column; gap: var(--space-6); }
  .seo-content__list-block { background: var(--color-neutral-50); padding: var(--space-5); border-radius: var(--radius-xl); border: 1px solid var(--color-neutral-100); }
  .seo-content__list-title { font-size: var(--text-base); font-weight: var(--font-semibold); margin-bottom: var(--space-3); color: var(--color-neutral-900); }
  .seo-content__list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .seo-content__list li { font-size: var(--text-sm); color: var(--color-neutral-700); line-height: var(--leading-relaxed); }

  /* ====== SEO TABLE ====== */
  .seo-table-wrap { background: var(--color-neutral-50); padding: var(--space-5); border-radius: var(--radius-xl); border: 1px solid var(--color-neutral-100); }
  .seo-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); margin-top: var(--space-3); }
  .seo-table th, .seo-table td { padding: var(--space-2) var(--space-3); border: 1px solid var(--color-neutral-200); text-align: left; }
  .seo-table th { background: var(--color-neutral-100); font-weight: var(--font-semibold); color: var(--color-neutral-700); }
  .seo-table td { color: var(--color-neutral-600); }
  .seo-table__link { color: var(--color-brand-brick); font-weight: var(--font-medium); text-decoration: none; }
  .seo-table__link:hover { text-decoration: underline; }
  .seo-table__note { font-size: var(--text-sm); color: var(--color-neutral-500); margin-top: var(--space-3); }
  .seo-table__note a { color: var(--color-brand-brick); font-weight: var(--font-medium); }

  /* ====== CATÉGORIES (piliers Cocon) ====== */
  .cats-section { padding: var(--space-10) 0; background: var(--color-neutral-50); border-top: 1px solid var(--color-neutral-100); }
  .cats-grid { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; max-width: 760px; margin: 0 auto; }
  .cat-pill {
    display: inline-flex; align-items: center; padding: var(--space-3) var(--space-5);
    background: white; color: var(--color-brand-brick); border-radius: var(--radius-full);
    text-decoration: none; font-weight: var(--font-semibold); font-size: var(--text-sm);
    border: 1.5px solid transparent; box-shadow: var(--shadow-soft); transition: all var(--transition-default);
  }
  .cat-pill:hover { border-color: var(--color-brand-brick); transform: translateY(-2px); box-shadow: var(--shadow-medium); }

  /* ====== FAQ SECTION ====== */
  .faq-section { padding: var(--space-10) 0; background: white; border-top: 1px solid var(--color-neutral-100); }
  .faq-grid { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-3); }
  .faq-item { background: var(--color-neutral-50); border-radius: var(--radius-lg); border: 1px solid var(--color-neutral-100); overflow: hidden; transition: all var(--transition-default); }
  .faq-item:hover { border-color: var(--color-brand-brick); }
  .faq-item__question { padding: var(--space-4) var(--space-5); font-weight: var(--font-semibold); font-size: var(--text-base); color: var(--color-neutral-900); cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .faq-item__question::-webkit-details-marker { display: none; }
  .faq-item__question::after { content: '+'; font-size: var(--text-lg); color: var(--color-brand-brick); font-weight: var(--font-bold); transition: transform var(--transition-default); flex-shrink: 0; }
  .faq-item[open] .faq-item__question::after { transform: rotate(45deg); }
  .faq-item__answer { padding: 0 var(--space-5) var(--space-4); font-size: var(--text-sm); line-height: var(--leading-relaxed); color: var(--color-neutral-600); }
</style>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('searchApp', () => ({
      query: '',
      results: [],
      highlightIndex: -1,
      async search() {
        if (this.query.length < 2) { this.results = []; this.highlightIndex = -1; return; }
        const q = this.query.toLowerCase();
        const res = [];
        try {
          const r = await fetch('/data/events-index.json');
          const idx = await r.json();
          for (const d of idx.departements || []) {
            const label = `${d.nom || `Département ${d.departement}`} (${d.departement})`;
            if (label.toLowerCase().includes(q)) {
              res.push({ label: `📍 ${label} — ${d.totalEvents} événements`, url: `/departement/${d.departement}/` });
            }
          }
        } catch {}
        const staticSuggestions = [
          { label: '🎵 Concerts', url: '/departement/' },
          { label: '🎭 Théâtre', url: '/departement/' },
          { label: '🖼️ Expositions', url: '/departement/' },
          { label: '🎪 Festivals', url: '/departement/' },
          { label: '👶 Enfants', url: '/departement/' },
        ];
        for (const s of staticSuggestions) {
          if (s.label.toLowerCase().includes(q)) res.push(s);
        }
        this.results = res.slice(0, 8);
        this.highlightIndex = -1;
      },
      highlightNext() {
        if (this.results.length === 0) return;
        this.highlightIndex = Math.min(this.highlightIndex + 1, this.results.length - 1);
      },
      highlightPrev() {
        if (this.results.length === 0) return;
        this.highlightIndex = Math.max(this.highlightIndex - 1, -1);
      },
      goToResult() {
        if (this.highlightIndex >= 0 && this.results[this.highlightIndex]) {
          window.location.href = this.results[this.highlightIndex].url;
        } else if (this.results.length === 1) {
          window.location.href = this.results[0].url;
        }
      },
      close() { this.results = []; this.highlightIndex = -1; },
    }));

    // ---- Carte Leaflet home — cercles proportionnels par département ----
    Alpine.data('mapApp', () => ({
      init() {
        const el = this.$el;
        const raw = el.dataset.depts || '[]';
        let depts = [];
        try { depts = JSON.parse(raw); } catch { depts = []; }

        // Coordonnées géographiques des départements
        const geo = {
          '01': [46.2, 5.2], '02': [49.6, 3.6], '03': [46.6, 3.3],
          '04': [44.1, 6.2], '05': [44.6, 6.1], '06': [43.7, 7.3],
          '07': [44.7, 4.6], '08': [49.8, 4.7], '09': [42.9, 1.6],
          '10': [48.3, 4.1], '11': [43.2, 2.4], '12': [44.4, 2.6],
          '13': [43.3, 5.4], '14': [49.2, -0.4], '15': [44.9, 2.4],
          '16': [45.7, 0.3], '17': [46.2, -1.2], '18': [47.1, 2.5],
          '19': [45.3, 1.8], '2A': [41.9, 8.7], '2B': [42.7, 9.4],
          '21': [47.3, 5.0], '22': [48.5, -2.8], '23': [46.2, 1.9],
          '24': [45.2, 0.7], '25': [47.2, 6.2], '26': [44.9, 4.9],
          '27': [49.1, 1.1], '28': [48.5, 1.4], '29': [48.0, -4.1],
          '30': [43.8, 4.4], '31': [43.6, 1.4], '32': [43.7, 0.6],
          '33': [44.8, -0.6], '34': [43.6, 3.9], '35': [48.1, -1.7],
          '36': [46.8, 1.7], '37': [47.4, 0.7], '38': [45.2, 5.7],
          '39': [46.7, 5.6], '40': [44.0, -1.0], '41': [47.5, 1.5],
          '42': [45.4, 4.4], '43': [45.0, 3.9], '44': [47.3, -1.8],
          '45': [47.9, 2.3], '46': [44.4, 1.4], '47': [44.2, 0.6],
          '48': [44.5, 3.5], '49': [47.5, -0.6], '50': [49.1, -1.1],
          '51': [49.0, 4.4], '52': [48.1, 5.1], '53': [48.1, -0.8],
          '54': [48.7, 6.2], '55': [49.0, 5.3], '56': [47.7, -2.8],
          '57': [49.1, 6.2], '58': [47.0, 3.2], '59': [50.6, 3.1],
          '60': [49.4, 2.5], '61': [48.4, 0.1], '62': [50.3, 2.8],
          '63': [45.8, 3.1], '64': [43.3, -0.4], '65': [43.2, 0.1],
          '66': [42.7, 2.9], '67': [48.6, 7.8], '68': [48.1, 7.4],
          '69': [45.8, 4.8], '70': [47.6, 6.2], '71': [46.3, 4.8],
          '72': [48.0, 0.2], '73': [45.6, 5.9], '74': [45.9, 6.1],
          '75': [48.8566, 2.3522], '76': [49.4, 1.1], '77': [48.5, 2.7],
          '78': [48.8, 2.1], '79': [46.5, -0.3], '80': [49.9, 2.3],
          '81': [43.8, 2.2], '82': [44.0, 1.4], '83': [43.1, 5.9],
          '84': [43.9, 4.8], '85': [46.7, -1.5], '86': [46.6, 0.3],
          '87': [45.8, 1.3], '88': [48.2, 6.5], '89': [47.8, 3.6],
          '90': [47.6, 6.9], '91': [48.6, 2.5], '92': [48.9, 2.2],
          '93': [48.9, 2.4], '94': [48.8, 2.5], '95': [49.1, 2.1],
        };

        // Palette brique
        const palette = [
          { max: Infinity, color: '#B84E23', label: '>1000' },
          { max: 1000, color: '#D45D2E', label: '100–999' },
          { max: 100, color: '#E8916E', label: '10–99' },
          { max: 10, color: '#B8B8C8', label: '1–9' },
          { max: 1, color: '#EDEBE3', label: '0' },
        ];

        const getColor = (n) => {
          for (const p of palette) if (n >= p.max) return p.color;
          return palette[palette.length - 1].color;
        };

        const loadMap = () => {
          if (typeof L === 'undefined') {
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
            document.head.appendChild(link);
            const s = document.createElement('script');
            s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
            s.onload = () => initMap();
            document.body.appendChild(s);
          } else {
            initMap();
          }
        };

        const initMap = () => {
          const map = L.map(el, {
            center: [46.8, 2.5],
            zoom: 6,
            zoomControl: true,
            scrollWheelZoom: true,
          });

          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 18,
          }).addTo(map);

          const circles = [];
          for (const d of depts) {
            const coord = geo[d.code];
            if (!coord) continue;
            const events = d.events || 0;
            const radius = Math.max(5, Math.log2(events + 1) * 3);
            const color = getColor(events);
            const circle = L.circleMarker(coord, {
              radius,
              fillColor: color,
              color: 'white',
              weight: 1.5,
              opacity: 0.9,
              fillOpacity: 0.8,
            }).addTo(map);

            circle.bindTooltip(`<strong>${d.nom || `Département ${d.code}`}</strong><br>${events.toLocaleString('fr-FR')} événement${events > 1 ? 's' : ''}`, {
              direction: 'top',
              offset: [0, -radius],
            });

            circle.on('click', () => {
              window.location.href = `/departement/${d.code}/`;
            });

            circles.push(circle);
          }

          if (circles.length > 0) {
            try {
              const bounds = L.featureGroup(circles).getBounds().pad(0.15);
              map.fitBounds(bounds);
            } catch {}
          }
        };

        loadMap();
      },
    }));
  });
</script>