---
// src/pages/index.astro — Page d'accueil SortirIci v2
// Hero minimal + Carte choroplèthe SVG + Départements par volume
import BaseLayout from '../layouts/BaseLayout.astro';

// ---- Chargement des données ----
let indexData = {
  totalEvents: 0,
  totalDepartements: 0,
  departements: [] as Array<{ departement: string; nom: string; totalEvents: number; visibleEvents: number }>,
  sources: [] as string[],
};
try {
  const { readFileSync } = await import('node:fs');
  const { join } = await import('node:path');
  const raw = readFileSync(join(process.cwd(), 'public', 'data', 'events-index.json'), 'utf-8');
  indexData = JSON.parse(raw);
} catch {
  /* Pas encore de données */
}

const orderedDepts = indexData.departements
  .filter(d => d.departement !== '00')
  .sort((a, b) => b.totalEvents - a.totalEvents);

const allDepts = orderedDepts;

// Seuils de couleur pour la carte Leaflet (cercles proportionnels)
function getChoroplethColor(events: number): string {
  if (events > 1000) return '#B84E23';     // brique foncé
  if (events >= 100) return '#D45D2E';     // brique moyen
  if (events >= 10) return '#E8916E';      // brique clair
  if (events >= 1) return '#B8B8C8';       // gris
  return '#EDEBE3';                         // gris clair (0)
}

// Coordonnées géographiques des départements (lat, lng) pour Leaflet
const deptGeoCoords: Record<string, [number, number]> = {
  '10': [48.3, 4.1],    // Aube
  '16': [45.7, 0.3],    // Charente
  '18': [47.1, 2.5],    // Cher
  '25': [47.2, 6.2],    // Doubs
  '27': [49.1, 1.1],    // Eure
  '28': [48.5, 1.4],    // Eure-et-Loir
  '33': [44.8, -0.6],   // Gironde
  '40': [44.0, -1.0],   // Landes
  '41': [47.5, 1.5],    // Loir-et-Cher
  '44': [47.3, -1.8],   // Loire-Atlantique
  '45': [47.9, 2.3],    // Loiret
  '55': [49.0, 5.3],    // Meuse
  '60': [49.4, 2.5],    // Oise
  '75': [48.8566, 2.3522], // Paris
  '79': [46.5, -0.3],   // Deux-Sèvres
  '81': [43.8, 2.2],    // Tarn
  '85': [46.7, -1.5],   // Vendée
  '92': [48.9, 2.2],    // Hauts-de-Seine
};

const siteUrl = 'https://sortirici.github.io';
const deptCount = allDepts.length;
const totalEvts = indexData.totalEvents;
const totalSources = indexData.sources?.length || 0;
const pageTitle = `SortirIci — ${totalEvts} événements culturels dans ${deptCount} départements | Agenda local France`;
const pageDesc = `Découvrez ${totalEvts} événements près de chez vous dans ${deptCount} départements : concerts, festivals, expositions, théâtre, ateliers. Agenda culturel local gratuit, 100% open data, zéro cookie, zéro tracking.`;

// ---- JSON-LD (page-specific) ----
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${siteUrl}/#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": siteUrl },
  ],
};
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${siteUrl}/#departements`,
  "name": "Départements couverts par SortirIci",
  "description": `Liste des ${allDepts.length} départements avec événements référencés — ${totalEvts} événements culturels`,
  "numberOfItems": allDepts.length,
  "itemListElement": allDepts.map((d, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": `Département ${d.departement} — ${d.nom || ''}`,
    "url": `${siteUrl}/departement/${d.departement}/`,
  })),
};

// ---- FAQPage JSON-LD ----
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${siteUrl}/#faq`,
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Qu'est-ce que SortirIci ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SortirIci est un agenda culturel local gratuit qui référence des événements (concerts, festivals, expositions, théâtre, ateliers) dans toute la France à partir de données open data publiques. 0 cookie, 0 tracking, 100% gratuit."
      }
    },
    {
      "@type": "Question",
      "name": "D'où viennent les données des événements ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Les événements proviennent exclusivement de sources open data publiques : portails open data des collectivités, OpenAgenda, Ministère de la Culture, et autres plateformes de données ouvertes. Chaque événement affiche sa source et sa licence."
      }
    },
    {
      "@type": "Question",
      "name": "SortirIci est-il gratuit ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, SortirIci est 100% gratuit, sans publicité, sans abonnement et sans collecte de données personnelles. Le code source est open source sous licence MIT."
      }
    },
    {
      "@type": "Question",
      "name": "Combien d'événements sont référencés ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Actuellement, SortirIci référence ${totalEvts} événements dans ${deptCount} départements français, provenant de ${totalSources} sources open data différentes.`
      }
    },
    {
      "@type": "Question",
      "name": "Comment trouver des événements près de chez moi ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Utilisez la barre de recherche pour trouver un département ou une ville, explorez la carte interactive, ou parcourez la liste des départements. Chaque page départementale permet de filtrer par catégorie, date, et gratuité."
      }
    },
    {
      "@type": "Question",
      "name": "Quels types d'événements puis-je trouver ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tous types d'événements culturels : concerts, festivals, expositions, théâtre, ateliers, conférences, cinéma, danse, cirque, spectacles pour enfants, foires et marchés."
      }
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical="/"
  jsonLd={[breadcrumbLd, itemListLd, faqLd]}
>
  <!-- Breadcrumb visible -->
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <div class="container">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
          <span>Accueil</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero Minimal v2 -->
  <section class="hero" aria-label="Présentation de SortirIci">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title">Sortir près de chez vous</h1>
        
        <p class="hero-subtitle">
          <strong>{totalEvts} événements</strong> référencés dans <strong>{deptCount} départements</strong> — concerts, festivals, expositions, théâtre, ateliers
        </p>
        
        <div class="search-bar" x-data="searchApp()" role="search" aria-label="Rechercher un événement">
          <div class="search-bar__wrapper">
            <svg class="search-bar__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input
              type="search"
              class="search-bar__input"
              placeholder="Rechercher un événement, une ville, un département…"
              aria-label="Rechercher un événement, une ville ou un département"
              x-model="query"
              @input.debounce.300ms="search()"
              @keydown.down.prevent="highlightNext()"
              @keydown.up.prevent="highlightPrev()"
              @keydown.enter.prevent="goToResult()"
              @keydown.escape.prevent="close()"
            />
            <button class="search-bar__submit" aria-label="Lancer la recherche" @click="goToResult()">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-4.35-4.35"/><circle cx="11" cy="11" r="8"/></svg>
            </button>
          </div>
          <ul
            class="search-bar__results"
            x-show="results.length > 0"
            x-cloak
            role="listbox"
            aria-label="Suggestions de recherche"
          >
            <template x-for="(r, i) in results" :key="r.url">
              <li>
                <a :href="r.url" class="search-bar__result" :class="{ 'search-bar__result--active': i === highlightIndex }" role="option" :aria-selected="i === highlightIndex" x-text="r.label" @mouseenter="highlightIndex = i"></a>
              </li>
            </template>
          </ul>
        </div>

        <!-- Ligne de confiance -->
        <p class="trust-line">100% open data · 0 cookie · Sources citées</p>
      </div>
    </div>
  </section>

  <!-- SEO Content Section -->
  <section class="seo-content" id="seo-content" aria-label="En savoir plus sur SortirIci">
    <div class="container">
      <div class="seo-content__grid">
        <div class="seo-content__text">
          <h2 class="seo-content__title">L'agenda culturel local 100% open data</h2>
          <p class="seo-content__para">
            <strong>SortirIci</strong> est un agenda culturel local gratuit qui référence <strong>{totalEvts} événements</strong> 
            dans <strong>{deptCount} départements</strong> français. Concerts, festivals, expositions, théâtre, ateliers, conférences — 
            toutes les sorties culturelles près de chez vous, réunies en un seul endroit.
          </p>
          <p class="seo-content__para">
            Notre particularité ? <strong>100% open data</strong>. Chaque événement provient de sources publiques ouvertes 
            (collectivités, ministères, plateformes collaboratives) et affiche clairement sa source et sa licence. 
            <strong>Zéro cookie, zéro tracking</strong> : votre vie privée est notre priorité.
          </p>
          <p class="seo-content__para">
            Que vous cherchiez un concert rock à Nantes, une exposition photo à Paris, un festival en Loire-Atlantique 
            ou un atelier pour enfants dans le Loiret, SortirIci vous aide à trouver la sortie culturelle idéale.
          </p>
        </div>
        <div class="seo-content__lists">
          <div class="seo-content__list-block">
            <h3 class="seo-content__list-title">Catégories d'événements</h3>
            <ul class="seo-content__list">
              <li>🎵 Concerts et spectacles</li>
              <li>🎪 Festivals et foires</li>
              <li>🖼️ Expositions et musées</li>
              <li>🎭 Théâtre et danse</li>
              <li>👶 Ateliers et activités enfants</li>
              <li>📚 Conférences et rencontres</li>
              <li>🎬 Cinéma et projections</li>
              <li>🎪 Cirque et arts de rue</li>
            </ul>
          </div>
          <div class="seo-content__list-block">
            <h3 class="seo-content__list-title">Sources open data</h3>
            <ul class="seo-content__list">
              <li>OpenAgenda — plateforme collaborative</li>
              <li>Ministère de la Culture — festivals labellisés</li>
              <li>Portails open data territoriaux</li>
              <li>Orléans Métropole, Clermont-Ferrand</li>
              <li>Nantes, Paris, Bordeaux, Toulouse</li>
              <li>Et {totalSources} sources partenaires</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Tableau comparatif des départements -->
      <div class="seo-table-wrap">
        <h3 class="seo-content__list-title">Top 5 départements les plus actifs</h3>
        <table class="seo-table">
          <thead>
            <tr>
              <th>Département</th>
              <th>Code</th>
              <th>Événements</th>
              <th>Part du total</th>
            </tr>
          </thead>
          <tbody>
            {allDepts.slice(0, 5).map(d => {
              const pct = ((d.totalEvents / totalEvts) * 100).toFixed(1);
              return (
                <tr>
                  <td><a href={`/departement/${d.departement}/`} class="seo-table__link">{d.nom || `Département ${d.departement}`}</a></td>
                  <td>{d.departement}</td>
                  <td>{d.totalEvents.toLocaleString('fr-FR')}</td>
                  <td>{pct}%</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <p class="seo-table__note">Parcourez <a href="/departement/">les {deptCount} départements</a> pour découvrir tous les événements près de chez vous.</p>
      </div>
    </div>
  </section>

  <!-- Carte Leaflet -- cercles proportionnels par département -->
  <section class="map-section" aria-label="Carte des événements par département">
    <div class="container">
      <h2 class="section-title">Explorez la carte</h2>
      <p class="section-desc">Visualisez les {totalEvts} événements culturels référencés partout en France, par département</p>
      
      <div
        class="leaflet-container"
        id="home-map"
        x-data="mapApp()"
        data-depts={JSON.stringify(allDepts.map(d => ({
          code: d.departement,
          nom: d.nom,
          events: d.totalEvents,
        })))}
        aria-label="Carte Leaflet de France — cercles proportionnels au nombre d'événements par département"
      ></div>

      <!-- Légende -->
      <div class="map-legend">
        <span class="legend-item"><span class="legend-swatch" style="background:#B84E23"></span> &gt;1000</span>
        <span class="legend-item"><span class="legend-swatch" style="background:#D45D2E"></span> 100–999</span>
        <span class="legend-item"><span class="legend-swatch" style="background:#E8916E"></span> 10–99</span>
        <span class="legend-item"><span class="legend-swatch" style="background:#B8B8C8"></span> 1–9</span>
        <span class="legend-item"><span class="legend-swatch" style="background:#EDEBE3"></span> 0</span>
      </div>
    </div>
  </section>

  <!-- Piliers Catégories (Cocon Sémantique — entrée des silos depuis le hub) -->
  <section class="cats-section" aria-label="Explorer par type de sortie">
    <div class="container">
      <h2 class="section-title">Explorer par type de sortie</h2>
      <p class="section-desc">Tous les événements culturels par catégorie, dans toute la France</p>
      <div class="cats-grid">
        {[
          ['concert', 'Concerts'], ['festival', 'Festivals'], ['exposition', 'Expositions'],
          ['theatre', 'Théâtre'], ['spectacle', 'Spectacles'], ['cinema', 'Cinéma'],
          ['danse', 'Danse'], ['cirque', 'Cirque'], ['atelier', 'Ateliers'],
          ['conference', 'Conférences'], ['lecture', 'Lectures'], ['enfants', 'Enfants'],
          ['marche', 'Marchés'], ['foire', 'Foires'], ['sport', 'Sport'],
        ].map(([c, l]) => (
          <a href={`/categorie/${c}/`} class="cat-pill">{l}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section" id="faq" aria-label="Questions fréquentes">
    <div class="container">
      <h2 class="section-title">Questions fréquentes</h2>
      <p class="section-desc">Tout ce que vous devez savoir sur SortirIci</p>
      <div class="faq-grid" itemscope itemtype="https://schema.org/FAQPage">
        <details class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <summary class="faq-item__question" itemprop="name">Qu'est-ce que SortirIci ?</summary>
          <div class="faq-item__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">SortirIci est un agenda culturel local gratuit qui référence des événements (concerts, festivals, expositions, théâtre, ateliers) dans toute la France à partir de données open data publiques. 0 cookie, 0 tracking, 100% gratuit.</div>
          </div>
        </details>
        <details class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <summary class="faq-item__question" itemprop="name">D'où viennent les données des événements ?</summary>
          <div class="faq-item__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">Les événements proviennent exclusivement de sources open data publiques : portails open data des collectivités, OpenAgenda, Ministère de la Culture, et autres plateformes de données ouvertes. Chaque événement affiche sa source et sa licence.</div>
          </div>
        </details>
        <details class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <summary class="faq-item__question" itemprop="name">SortirIci est-il gratuit ?</summary>
          <div class="faq-item__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">Oui, SortirIci est 100% gratuit, sans publicité, sans abonnement et sans collecte de données personnelles. Le code source est open source sous licence MIT.</div>
          </div>
        </details>
        <details class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <summary class="faq-item__question" itemprop="name">Comment trouver des événements près de chez moi ?</summary>
          <div class="faq-item__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">Utilisez la barre de recherche pour trouver un département ou une ville, explorez la carte interactive, ou parcourez la liste des départements. Chaque page départementale permet de filtrer par catégorie, date, et gratuité.</div>
          </div>
        </details>
        <details class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <summary class="faq-item__question" itemprop="name">Quels types d'événements puis-je trouver ?</summary>
          <div class="faq-item__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">Tous types d'événements culturels : concerts, festivals, expositions, théâtre, ateliers, conférences, cinéma, danse, cirque, spectacles pour enfants, foires et marchés.</div>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Départements : un seul bloc trié par volume décroissant -->
  <section class="depts-section" id="departements-grid" aria-label="Liste des départements">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">
          Tous les départements
          {allDepts.length > 0 && <span class="section-badge">{allDepts.length}</span>}
        </h2>
        <p class="section-desc">Choisissez un département pour découvrir les événements près de chez vous</p>
      </div>

      {allDepts.length > 0 ? (
        <div class="depts-grid">
          {allDepts.map(d => {
            const size = Math.min(2.5, Math.max(1, Math.log2(d.totalEvents + 1) / 2));
            return (
              <a
                href={`/departement/${d.departement}/`}
                class="departement-card"
                aria-label={`Département ${d.nom || d.departement} — ${d.totalEvents} événements`}
                style={`--card-scale: ${size}`}
              >
                <span class="departement-card__numero" style={`font-size: clamp(1.2rem, ${size * 0.8 + 0.8}rem, 2.2rem)`}>{d.departement}</span>
                <span class="departement-card__nom">{d.nom || `Département ${d.departement}`}</span>
                <span class="departement-card__count">{d.totalEvents.toLocaleString('fr-FR')} événement{(d.totalEvents > 1) ? 's' : ''}</span>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="empty-state" role="status">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-neutral-300)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
          <h3>Les données arrivent bientôt</h3>
          <p>Les événements sont en cours de collecte. Revenez dans quelques instants !</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ====== HERO V2 (minimal) ====== */
  .hero {
    background: var(--color-neutral-50);
    padding: var(--space-8) 0 var(--space-6);
    position: relative;
  }
  .hero-content {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .hero-title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    color: var(--color-neutral-900);
    margin-bottom: var(--space-2);
    letter-spacing: -0.02em;
  }
  .hero-subtitle {
    font-size: var(--text-base);
    color: var(--color-neutral-500);
    margin-bottom: var(--space-4);
    font-weight: var(--font-normal);
    line-height: var(--leading-relaxed);
  }
  .hero-subtitle strong {
    color: var(--color-brand-brick);
    font-weight: var(--font-semibold);
  }
  .trust-line {
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
    margin-top: var(--space-3);
    font-weight: var(--font-medium);
    letter-spacing: 0.02em;
  }

  /* Search */
  .search-bar {
    max-width: 520px;
    margin: 0 auto;
    position: relative;
  }
  .search-bar__wrapper {
    display: flex;
    align-items: center;
    background: white;
    border: 1.5px solid var(--color-neutral-300);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    box-shadow: var(--shadow-soft);
    transition: all var(--transition-default);
    position: relative;
  }
  .search-bar__wrapper:focus-within {
    border-color: var(--color-brand-brick);
    box-shadow: var(--shadow-medium), 0 0 0 3px rgba(212,93,46,0.1);
    outline: none;
  }
  .search-bar__icon {
    flex-shrink: 0;
    color: var(--color-neutral-400);
    margin-right: var(--space-2);
  }
  .search-bar__input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: var(--text-sm);
    padding: var(--space-1) 0;
    color: var(--color-neutral-900);
    outline: none;
    font-family: var(--font-sans);
  }
  .search-bar__input::placeholder { color: var(--color-neutral-400); }
  .search-bar__submit {
    flex-shrink: 0;
    background: var(--color-brand-brick);
    color: white;
    border: none;
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    transition: background var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }
  .search-bar__submit:hover { background: #B84E23; }
  .search-bar__submit svg { margin-right: 4px; }
  .search-bar__results {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    list-style: none;
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-strong);
    border: 1px solid var(--color-neutral-200);
