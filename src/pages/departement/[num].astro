---
// src/pages/departement/[num].astro — Hub département
// Liste événements + carte Leaflet + filtres Alpine.js + JSON-LD + maillage sémantique
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  let depts = [];
  try {
    const { readdirSync } = await import('node:fs');
    const { join } = await import('node:path');
    const dir = join(process.cwd(), 'public', 'data');
    depts = readdirSync(dir)
      .filter(f => f.startsWith('events-') && f.endsWith('.json') && f !== 'events-index.json')
      .map(f => f.replace('events-', '').replace('.json', ''));
  } catch {}
  return depts.length > 0
    ? depts.map(num => ({ params: { num } }))
    : [{ params: { num: '45' } }];
}

const { num } = Astro.params;

// ---- Chargement des données ----
let events = [];
let deptNom = `Département ${num}`;
let deptRegion = '';
let allSources = [];
try {
  const { readFileSync } = await import('node:fs');
  const { join } = await import('node:path');
  const raw = readFileSync(join(process.cwd(), 'public', 'data', `events-${num}.json`), 'utf-8');
  events = JSON.parse(raw);
  if (events.length > 0) {
    deptNom = events[0].lieuDepartement || deptNom;
    deptRegion = events[0].lieuRegion || '';
  }
  const rawIdx = readFileSync(join(process.cwd(), 'public', 'data', 'events-index.json'), 'utf-8');
  allSources = JSON.parse(rawIdx).sources || [];
} catch {}

const categories = [...new Set(events.map(e => e.categorie).filter(Boolean))];
const villes = [...new Set(events.map(e => e.lieuCommune).filter(Boolean))];

const siteUrl = 'https://sortirici.github.io';
const pageTitle = `${deptNom} (${num}) — Sortir dans le ${deptNom} — Événements | SortirIci`;
const pageDesc = `Découvrez tous les événements dans le ${deptNom}${deptRegion ? ` (${deptRegion})` : ''} : concerts, festivals, expositions, théâtre, ateliers. ${events.length} événements référencés.`;

// ---- JSON-LD (page-specific ; Organization + WebSite déjà dans BaseLayout) ----
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${siteUrl}/departement/${num}/#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Départements", "item": `${siteUrl}/departement/` },
    { "@type": "ListItem", "position": 3, "name": `${deptNom} (${num})`, "item": `${siteUrl}/departement/${num}/` },
  ],
};
const placeLd = {
  "@context": "https://schema.org",
  "@type": "AdministrativeArea",
  "@id": `${siteUrl}/departement/${num}/#place`,
  "name": deptNom,
  "identifier": num,
  "containedInPlace": deptRegion ? { "@type": "AdministrativeArea", "name": deptRegion } : undefined,
  "description": `Département ${deptNom}${deptRegion ? `, région ${deptRegion}` : ''}. ${events.length} événements référencés sur SortirIci.`,
  "additionalProperty": {
    "@type": "PropertyValue",
    "name": "eventsCount",
    "value": events.length,
  },
};
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${siteUrl}/departement/${num}/#events`,
  "name": `Événements dans le ${deptNom}`,
  "description": `Liste des ${events.length} événements à venir dans le département ${deptNom}${deptRegion ? ` (${deptRegion})` : ''}`,
  "numberOfItems": events.length,
  "itemListElement": events.slice(0, 20).map((e: any, i: number) => ({
    "@type": "ListItem", "position": i + 1,
    "url": `${siteUrl}/evenement/${e.slug || e.uid}/`,
  })),
};

// Événements en vedette avec JSON-LD Event (top 3)
const featuredEvents = events.slice(0, 3).map((e: any) => ({
  "@context": "https://schema.org",
  "@type": "Event",
  "name": e.titre,
  "startDate": e.dateDebut || '',
  "endDate": e.dateFin || e.dateDebut || '',
  "location": {
    "@type": "Place",
    "name": e.lieuNom || e.lieuCommune || '',
    "address": {
      "@type": "PostalAddress",
      "addressLocality": e.lieuCommune || '',
      "addressRegion": deptNom,
      "addressCountry": "FR",
    },
  },
  "url": `${siteUrl}/evenement/${e.slug || e.uid}/`,
  "isAccessibleForFree": e.gratuit || false,
}));
---

<BaseLayout title={pageTitle} description={pageDesc} canonical={`/departement/${num}/`} jsonLd={[breadcrumbLd, placeLd, itemListLd, ...featuredEvents]}>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <div class="container">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/" class="breadcrumb__link">Accueil</a><svg class="breadcrumb__sep" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></li>
        <li class="breadcrumb__item"><a href="/departement/" class="breadcrumb__link">Départements</a><svg class="breadcrumb__sep" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></li>
        <li class="breadcrumb__item breadcrumb__item--current" aria-current="page"><span>{deptNom} ({num})</span></li>
      </ol>
    </div>
  </nav>

  <!-- En-tête -->
  <section class="dept-header" aria-label="Présentation du département">
    <div class="container">
      <div class="dept-header__content">
        <div class="dept-header__info">
          <div class="dept-header__numero">{num}</div>
          <div>
            <h1 class="dept-header__title">Le {deptNom}</h1>
            {deptRegion && <p class="dept-header__region">{deptRegion}</p>}
            <p class="dept-header__stats"><strong>{events.length}</strong> événement{events.length !== 1 ? 's' : ''} · <a href="/sources/" class="dept-header__link">{allSources.length} sources</a> · <a href="/" class="dept-header__link">← Accueil</a></p>
          </div>
        </div>
        <div class="dept-header__cats">
          {categories.slice(0, 8).map(cat => (
            <a href={`/departement/${num}/${cat}/`} class="category-chip">{cat.charAt(0).toUpperCase() + cat.slice(1)}</a>
          ))}
          {categories.length > 8 && <span class="category-chip category-chip--more">+{categories.length - 8}</span>}
        </div>
      </div>
    </div>
  </section>

  <!-- Texte d'introduction SEO -->
  <section class="dept-seo-intro" aria-label="Introduction SEO">
    <div class="container">
      <p class="dept-seo-intro__text">
        Découvrez les <strong>{events.length} événement{events.length !== 1 ? 's' : ''} à venir dans le {deptNom}</strong>{deptRegion ? ` (${deptRegion})` : ''} : {categories.slice(0, 5).map(c => c.toLowerCase()).join(', ')}. 
        {villes.length > 1 ? `Retrouvez les sorties dans ${villes.length > 5 ? 'les principales villes' : villes.slice(0, 5).join(', ')}.` : ''}
        Planifiez vos sorties culturelles grâce à notre agenda 100% open data, actualisé chaque semaine.
      </p>
    </div>
  </section>

  <!-- Filtres -->
  <section class="filters" aria-label="Filtrer les événements">
    <div class="container">
      <div class="filter-panel" x-data>
        <div class="filter-panel__controls">
          <div class="filter-panel__search">
            <input type="search" class="filter-panel__input" placeholder="Rechercher…" aria-label="Rechercher" x-model="$store.filters.searchQuery" />
          </div>
          <fieldset class="filter-panel__group">
            <legend class="filter-panel__legend">Catégorie</legend>
            <div class="filter-panel__chips">
              <button class="filter-chip" :class="{ 'filter-chip--active': $store.filters.selectedCat === 'all' }" @click="$store.filters.selectedCat = 'all'">Toutes</button>
              {categories.map(cat => (
                <button class="filter-chip" :class={`{ 'filter-chip--active': $store.filters.selectedCat === '${cat}' }`} @click={`$store.filters.selectedCat = '${cat}'`}>{cat.charAt(0).toUpperCase() + cat.slice(1)}</button>
              ))}
            </div>
          </fieldset>
          <fieldset class="filter-panel__group">
            <legend class="filter-panel__legend">Période</legend>
            <div class="filter-panel__chips">
              <button class="filter-chip" :class="{ 'filter-chip--active filter-chip--date': $store.filters.selectedDate === 'today' }" @click="$store.filters.selectedDate = 'today'">Aujourd'hui</button>
              <button class="filter-chip" :class="{ 'filter-chip--active filter-chip--date': $store.filters.selectedDate === 'week' }" @click="$store.filters.selectedDate = 'week'">Cette semaine</button>
              <button class="filter-chip" :class="{ 'filter-chip--active filter-chip--date': $store.filters.selectedDate === 'month' }" @click="$store.filters.selectedDate = 'month'">Ce mois</button>
              <button class="filter-chip" :class="{ 'filter-chip--active filter-chip--date': $store.filters.selectedDate === 'all' }" @click="$store.filters.selectedDate = 'all'">Toutes</button>
            </div>
          </fieldset>
          <div class="filter-panel__toggle">
            <label class="filter-toggle">
              <div class="filter-toggle__switch" :class="{ 'filter-toggle__switch--active': $store.filters.freeOnly }" @click="$store.filters.freeOnly = !$store.filters.freeOnly" role="switch" :aria-checked="$store.filters.freeOnly" tabindex="0" @keydown.enter.prevent="$store.filters.freeOnly = !$store.filters.freeOnly" @keydown.space.prevent="$store.filters.freeOnly = !$store.filters.freeOnly">
                <span class="filter-toggle__knob" :class="{ 'filter-toggle__knob--active': $store.filters.freeOnly }"></span>
              </div>
              <span class="filter-toggle__label">Gratuit</span>
            </label>
          </div>
          <div class="filter-panel__results" role="status" aria-live="polite">
            <span x-text="$store.filters.filteredCount + ' événement' + ($store.filters.filteredCount > 1 ? 's' : '')"></span>
            <button class="filter-panel__reset" @click="resetAllFilters()" x-show="$store.filters.hasFilterActive" x-cloak>Réinitialiser</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Carte + Liste -->
  <section class="content" aria-label="Événements">
    <div class="container">
      <div class="content-layout">
        <div class="content-layout__map">
          <h2 class="map-title">Carte</h2>
          <div id="dept-map" class="map-container" aria-label="Carte des événements" x-data="mapApp()" data-map-type="department" data-events={JSON.stringify(events.filter(e => e.lieuLatitude && e.lieuLongitude).slice(0, 100).map(e => ({ lat: parseFloat(e.lieuLatitude), lng: parseFloat(e.lieuLongitude), title: e.titre, slug: e.slug || e.uid })))}>
            <noscript><div class="map-fallback">Carte interactive nécessite JS. <a href="#events-list">Voir la liste</a>.</div></noscript>
          </div>
        </div>
        <div class="content-layout__list" id="events-list">
          <div class="events-list" x-data="{
            events: [],
            filteredEvents: [], currentPage: 1, perPage: 20,
            init() {
              const el = this.$el;
              try { this.events = JSON.parse(el.dataset.events); } catch(e) { this.events = []; }
              this.filteredEvents = this.events;
              this.$watch('$store.filters', () => this.applyFilters());
            },
            applyFilters() {
              const f = this.$store.filters;
              let r = this.events;
              if (f.searchQuery.length >= 2) { const q = f.searchQuery.toLowerCase(); r = r.filter(e => (e.titre||'').toLowerCase().includes(q) || (e.lieuCommune||'').toLowerCase().includes(q)); }
              if (f.selectedCat !== 'all') r = r.filter(e => e.categorie === f.selectedCat);
              if (f.freeOnly) r = r.filter(e => e.gratuit === true);
              const now = new Date();
              if (f.selectedDate === 'today') r = r.filter(e => new Date(e.dateDebut).toDateString() === now.toDateString());
              else if (f.selectedDate === 'week') { const w = new Date(now); w.setDate(now.getDate()+7); r = r.filter(e => { const d = new Date(e.dateDebut); return d >= now && d <= w; }); }
              else if (f.selectedDate === 'month') { const m = new Date(now); m.setMonth(now.getMonth()+1); r = r.filter(e => { const d = new Date(e.dateDebut); return d >= now && d <= m; }); }
              this.filteredEvents = r; this.currentPage = 1;
              // Sync to store for filter panel display
              this.$store.filters.filteredCount = this.filteredEvents.length;
              this.$store.filters.hasFilterActive = f.searchQuery.length>=2 || f.selectedCat!=='all' || f.selectedDate!=='all' || f.freeOnly;
            },
            get filteredCount() { return this.filteredEvents.length; },
            get hasFilterActive() {
              const f = this.$store.filters;
              return f.searchQuery.length>=2 || f.selectedCat!=='all' || f.selectedDate!=='all' || f.freeOnly;
            },
            resetAllFilters() {
              const f = this.$store.filters;
              f.searchQuery = ''; f.selectedCat = 'all'; f.selectedDate = 'all'; f.freeOnly = false;
              this.currentPage = 1; this.applyFilters();
            },
            get paginatedEvents() { const s=(this.currentPage-1)*this.perPage; return this.filteredEvents.slice(s, s+this.perPage); },
            get totalPages() { return Math.ceil(this.filteredEvents.length/this.perPage); },
            goToPage(p) { if(p>=1&&p<=this.totalPages){this.currentPage=p;window.scrollTo({top:document.getElementById('events-list')?.offsetTop-100,behavior:'smooth'});} },
            paginationNumbers() { const t=this.totalPages,c=this.currentPage,p=[];let s=Math.max(1,c-2),e=Math.min(t,c+2);if(s>1){p.push(1);if(s>2)p.push('...');}for(let i=s;i<=e;i++)p.push(i);if(e<t){if(e<t-1)p.push('...');p.push(t);}return p;},
          }" data-events={JSON.stringify(events.map((e: any) => ({ uid: e.uid, titre: e.titre, slug: e.slug, categorie: e.categorie, dateDebut: e.dateDebut, gratuit: e.gratuit, lieuCommune: e.lieuCommune, lieuNom: e.lieuNom, descriptionCourte: (e.descriptionCourte || '').slice(0, 150) })))}>
            <template x-if="filteredEvents.length === 0">
              <div class="empty-state" role="status">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-neutral-300)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                <h3>Aucun résultat</h3>
                <p>Essayez de modifier vos filtres.</p>
                <button class="btn btn--outline" @click="resetAllFilters()">Réinitialiser</button>
              </div>
            </template>
            <template x-if="filteredEvents.length > 0">
              <div>
                <div class="events-list__items">
                  <template x-for="e in paginatedEvents" :key="e.uid">
                    <article class="event-card" itemscope itemtype="https://schema.org/Event">
                      <div class="event-card__body">
                        <div class="event-card__meta">
                          <span class="category-chip" x-text="e.categorie"></span>
                          <span class="badge badge--gratuit" x-show="e.gratuit">Gratuit</span>
                        </div>
                        <h3 class="event-card__title"><a :href="`/evenement/${e.slug}/`" class="event-card__link" x-text="e.titre"></a></h3>
                        <div class="event-card__info"><span class="event-card__date" x-text="formatDate(e.dateDebut)"></span><span class="event-card__sep" aria-hidden="true">·</span><span class="event-card__place" x-text="e.lieuCommune"></span></div>
                        <p class="event-card__desc" x-show="e.descriptionCourte" x-text="e.descriptionCourte"></p>
                        <a :href="`/evenement/${e.slug}/`" class="event-card__cta">Détails →</a>
                      </div>
                    </article>
                  </template>
                </div>
                <nav class="pagination" aria-label="Pagination" x-show="totalPages > 1">
                  <button class="pagination__btn" :disabled="currentPage===1" @click="goToPage(currentPage-1)" aria-label="Précédente"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>Préc.</button>
                  <div class="pagination__pages"><template x-for="p in paginationNumbers()" :key="p"><button class="pagination__page" :class="{'pagination__page--active':p===currentPage}" @click="goToPage(p)" :aria-label="`Page ${p}`" :aria-current="p===currentPage?'page':undefined" x-text="p"></button></template></div>
                  <button class="pagination__btn" :disabled="currentPage===totalPages" @click="goToPage(currentPage+1)" aria-label="Suivante">Suiv.<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></button>
                </nav>
              </div>
            </template>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Maillage -->
  <section class="cross-links" aria-label="Explorer">
    <div class="container">
      <div class="cross-links__grid">
        <div class="cross-links__block">
          <h2 class="cross-links__title">Villes</h2>
          <nav class="cross-links__list" aria-label="Villes du département">
            {villes.slice(0, 12).map(v => <a href={`/departement/${num}/`} class="cross-links__item">{v}</a>)}
            {villes.length > 12 && <span class="cross-links__more">et {villes.length - 12} autres</span>}
          </nav>
        </div>
        <div class="cross-links__block">
          <h2 class="cross-links__title">Catégories</h2>
          <nav class="cross-links__list" aria-label="Catégories">
            {categories.map(cat => <a href={`/departement/${num}/${cat}/`} class="cross-links__item cross-links__item--cat">{cat.charAt(0).toUpperCase() + cat.slice(1)}</a>)}
          </nav>
        </div>
        <div class="cross-links__block">
          <h2 class="cross-links__title">Liens</h2>
          <nav class="cross-links__list" aria-label="Liens utiles">
            <a href="/" class="cross-links__item">← Accueil</a>
            <a href="/departement/" class="cross-links__item">Tous les départements</a>
            <a href="/sources/" class="cross-links__item">Sources</a>
            <a href="/mentions/" class="cross-links__item">Mentions</a>
          </nav>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .breadcrumb { background: white; border-bottom: 1px solid var(--color-neutral-200); }
  .breadcrumb__list { display: flex; align-items: center; gap: var(--space-2); list-style: none; padding: var(--space-3) 0; font-size: var(--text-sm); flex-wrap: wrap; }
  .breadcrumb__item { display: flex; align-items: center; gap: var(--space-1); }
  .breadcrumb__link { color: var(--color-neutral-500); text-decoration: none; }
  .breadcrumb__link:hover { color: var(--color-brand-brick); }
  .breadcrumb__item--current span { color: var(--color-neutral-900); font-weight: var(--font-semibold); }
  .breadcrumb__sep { color: var(--color-neutral-300); flex-shrink: 0; }

  .dept-header { background: linear-gradient(135deg,var(--color-neutral-50),#E8F0FA,var(--color-neutral-50)); padding: var(--space-8) 0; }
  .dept-header__content { display: flex; flex-direction: column; gap: var(--space-4); }
  .dept-header__info { display: flex; align-items: flex-start; gap: var(--space-4); }
  .dept-header__numero { font-size: 3.5rem; font-weight: var(--font-bold); color: var(--color-brand-brick); line-height: 0.9; flex-shrink: 0; min-width: 80px; text-align: center; }
  .dept-header__title { font-size: var(--text-3xl); font-weight: var(--font-bold); }
  .dept-header__region { font-size: var(--text-base); color: var(--color-neutral-500); margin-top: var(--space-1); }
  .dept-header__stats { font-size: var(--text-sm); color: var(--color-neutral-500); margin-top: var(--space-2); }
  .dept-header__link { color: var(--color-brand-brick); font-weight: var(--font-medium); }
  .dept-header__cats { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .category-chip { display: inline-flex; align-items: center; padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: var(--font-medium); background: #E8F0FA; color: var(--color-brand-brick); text-decoration: none; transition: all var(--transition-fast); }
  .category-chip:hover { background: var(--color-brand-brick); color: white; }
  .category-chip--more { background: var(--color-neutral-200); color: var(--color-neutral-500); cursor: default; }

  .dept-seo-intro { background: var(--color-neutral-50); padding: var(--space-3) 0 var(--space-1); border-bottom: 1px solid var(--color-neutral-200); }
  .dept-seo-intro__text { font-size: var(--text-sm); line-height: 1.7; color: var(--color-neutral-600); max-width: 72ch; }
  .dept-seo-intro__text strong { color: var(--color-neutral-900); }

  .filters { padding: var(--space-4) 0; background: white; border-bottom: 1px solid var(--color-neutral-200); }
  .filter-panel__controls { display: flex; flex-direction: column; gap: var(--space-3); }
  .filter-panel__search { max-width: 400px; }
  .filter-panel__input { width: 100%; padding: var(--space-2) var(--space-4); border-radius: var(--radius-lg); border: 1.5px solid var(--color-neutral-200); font-size: var(--text-sm); font-family: var(--font-sans); }
  .filter-panel__input:focus { border-color: var(--color-brand-brick); outline: none; box-shadow: 0 0 0 3px rgba(26,95,180,0.15); }
  .filter-panel__group { border: none; padding: 0; margin: 0; }
  .filter-panel__legend { font-size: var(--text-xs); font-weight: var(--font-semibold); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-neutral-400); margin-bottom: var(--space-2); }
  .filter-panel__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .filter-chip { padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); border: 1.5px solid var(--color-neutral-200); font-size: var(--text-sm); cursor: pointer; transition: all var(--transition-fast); background: white; font-family: var(--font-sans); color: var(--color-neutral-700); }
  .filter-chip:hover { border-color: var(--color-brand-brick); color: var(--color-brand-brick); }
  .filter-chip--active { background: var(--color-brand-brick); color: white; border-color: var(--color-brand-brick); }
  .filter-chip--date.filter-chip--active { background: var(--color-brand-brick); border-color: var(--color-brand-brick); }
  .filter-panel__toggle { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .filter-toggle { display: flex; align-items: center; gap: var(--space-2); cursor: pointer; }
  .filter-toggle__switch { width: 40px; height: 22px; border-radius: var(--radius-full); background: var(--color-neutral-200); transition: background var(--transition-fast); position: relative; flex-shrink: 0; }
  .filter-toggle__switch--active { background: var(--color-brand-green); }
