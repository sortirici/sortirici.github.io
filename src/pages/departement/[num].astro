---
// src/pages/departement/[num].astro — Hub département simple
// Prêt pour le build, sans TypeScript complexe
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  let depts = [];
  try {
    const { readdirSync } = await import('node:fs');
    const { join } = await import('node:path');
    const dir = join(process.cwd(), 'public', 'data');
    depts = readdirSync(dir)
      .filter(f => f.startsWith('events-') && f.endsWith('.json') && f !== 'events-index.json')
      .map(f => f.replace('events-', '').replace('.json', ''));
  } catch {}
  return depts.length > 0
    ? depts.map(num => ({ params: { num } }))
    : [{ params: { num: '45' } }];
}

const { num } = Astro.params;
const siteUrl = 'https://sortirici.github.io';
const pageTitle = `Département ${num} — Sortir dans le ${num} — Événements | SortirIci`;
const pageDesc = `Découvrez tous les événements dans le département ${num}.`;

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": `Département ${num}`, "item": `${siteUrl}/departement/${num}/` },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={`/departement/${num}/`}
  jsonLd={[breadcrumbLd]}
>
  <div class="container" style="padding: 3rem 1rem;">
    <nav aria-label="Fil d'Ariane" style="margin-bottom: 1rem; font-size: 0.875rem; color: #6A6A8A;">
      <a href="/" style="color: #6A6A8A;">Accueil</a>
      <span style="margin: 0 0.5rem;">›</span>
      <span style="color: #1A1A2E; font-weight: 600;">Département {num}</span>
    </nav>

    <h1 style="font-size: 2.25rem; font-weight: 700; margin-bottom: 0.5rem; color: #1A1A2E;">
      Département {num}
    </h1>
    <p style="color: #6A6A8A; margin-bottom: 2rem; font-size: 1.125rem;">
      Événements, sorties, concerts, festivals dans le département {num}.
    </p>

    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4rem 1rem; text-align: center; background: #F0F0F5; border-radius: 0.75rem;">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#CACADD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 1rem;">
        <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
      </svg>
      <h2 style="font-size: 1.25rem; font-weight: 600; color: #1A1A2E; margin-bottom: 0.5rem;">
        Chargement des événements
      </h2>
      <p style="color: #6A6A8A; max-width: 400px; line-height: 1.5;">
        Les données seront disponibles après le prochain cycle de mise à jour des sources open data.
      </p>
      <a href="/" style="margin-top: 1rem; padding: 0.75rem 2rem; background: #1A5FB4; color: white; border-radius: 0.75rem; text-decoration: none; font-weight: 600;">
        Retour à l'accueil
      </a>
    </div>
  </div>
</BaseLayout>