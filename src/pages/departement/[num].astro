<script>
document.addEventListener('alpine:init', () => {
  // ---- Store de filtres partagé entre le panneau de filtres et la liste d'événements ----
  Alpine.store('filters', {
    searchQuery: '',
    selectedCat: 'all',
    selectedDate: 'all',
    freeOnly: false,
    filteredCount: 0,
    hasFilterActive: false,
  });

  // ---- Carte Leaflet ----
  Alpine.data('mapApp', () => ({
    init() {
      const el = this.$el;
      const rawEvents = el.dataset.events || '[]';
      let events = [];
      try { events = JSON.parse(rawEvents); } catch { events = []; }
      // Filtrer les coordonnées invalides
      events = events.filter(e => {
        const lat = parseFloat(e.lat);
        const lng = parseFloat(e.lng);
        return !isNaN(lat) && !isNaN(lng) && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180;
      });
      if (events.length === 0) return;
      const loadMap = () => {
        if (typeof L === 'undefined') {
          const link = document.createElement('link'); link.rel = 'stylesheet'; link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'; document.head.appendChild(link);
          const s = document.createElement('script'); s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'; s.onload = () => initMap(events, el); document.body.appendChild(s);
        } else { initMap(events, el); }
      };
      const initMap = (events, el) => {
        const lat = events.reduce((s, e) => s + parseFloat(e.lat), 0) / events.length;
        const lng = events.reduce((s, e) => s + parseFloat(e.lng), 0) / events.length;
        const map = L.map(el, { center: [lat||46.6, lng||2.5], zoom: 10 });
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 18 }).addTo(map);
        const markers = [];
        for (const e of events) {
          const m = L.marker([parseFloat(e.lat), parseFloat(e.lng)], { title: e.title }).addTo(map);
          m.bindPopup(`<strong>${e.title}</strong><br><a href="/evenement/${e.slug}/">Détails →</a>`);
          markers.push(m);
        }
        if (markers.length > 0) { try { map.fitBounds(L.featureGroup(markers).getBounds().pad(0.1)); } catch {} }
      };
      loadMap();
    },
  }));
});
window.formatDate = function(iso) {
  if (!iso) return '';
  try { return new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }); } catch { return ''; }
};
</script>