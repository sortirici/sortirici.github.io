---
// src/pages/departement/index.astro — Liste de tous les départements (v2)
import BaseLayout from '../../layouts/BaseLayout.astro';

let indexData = {
  totalEvents: 0,
  totalDepartements: 0,
  departements: [] as Array<{ departement: string; nom: string; totalEvents: number; visibleEvents: number }>,
  sources: [] as string[],
};
try {
  const { readFileSync } = await import('node:fs');
  const { join } = await import('node:path');
  const raw = readFileSync(join(process.cwd(), 'public', 'data', 'events-index.json'), 'utf-8');
  indexData = JSON.parse(raw);
} catch {}

const orderedDepts = indexData.departements
  .filter(d => d.departement !== '00')
  .sort((a, b) => b.totalEvents - a.totalEvents);

const siteUrl = 'https://sortirici.github.io';
const pageTitle = 'Tous les départements — Événements culturels par département | SortirIci';
const pageDesc = `Explorez les ${indexData.totalDepartements} départements couverts par SortirIci et découvrez ${indexData.totalEvents.toLocaleString('fr-FR')} événements culturels près de chez vous : concerts, festivals, expositions, théâtre, ateliers.`;

// JSON-LD
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${siteUrl}/departement/#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Départements", "item": `${siteUrl}/departement/` },
  ],
};
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${siteUrl}/departement/#list`,
  "name": `Les ${orderedDepts.length} départements`,
  "description": `Liste des ${orderedDepts.length} départements français couverts par SortirIci avec événements à venir`,
  "numberOfItems": orderedDepts.length,
  "itemListElement": orderedDepts.slice(0, 30).map((d, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${siteUrl}/departement/${d.departement}/`,
  })),
};

function getSize(events: number): number {
  return Math.min(2.5, Math.max(1, Math.log2(events + 1) / 2));
}
---

<BaseLayout title={pageTitle} description={pageDesc} canonical="/departement/" jsonLd={[breadcrumbLd, itemListLd]}>
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <div class="container">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/" class="breadcrumb__link">Accueil</a><svg class="breadcrumb__sep" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></li>
        <li class="breadcrumb__item breadcrumb__item--current" aria-current="page"><span>Tous les départements</span></li>
      </ol>
    </div>
  </nav>

  <section class="depts-page" aria-label="Liste des départements">
    <div class="container">
      <header class="depts-page__header">
        <h1 class="depts-page__title">Tous les départements</h1>
        <p class="depts-page__desc">{orderedDepts.length > 0 ? `${orderedDepts.length} départements · ${indexData.totalEvents.toLocaleString('fr-FR')} événements` : 'Les données arrivent bientôt'}</p>
      </header>

      <!-- SEO Intro -->
      <section class="depts-seo" id="seo-intro" aria-label="Présentation des départements">
        <p class="depts-seo__text">
          <strong>SortirIci</strong> référence <strong>{indexData.totalEvents.toLocaleString('fr-FR')} événements culturels</strong> dans <strong>{orderedDepts.length} départements</strong> français. 
          Concerts, festivals, expositions, théâtre, ateliers, conférences — cliquez sur un département pour découvrir toutes les sorties près de chez vous.
          Les données sont 100% open data, mises à jour chaque semaine, zéro cookie, zéro tracking.
        </p>
        <nav class="depts-anchors" aria-label="Navigation rapide">
          <a href="#depts-grid" class="depts-anchors__link">Voir la liste des départements</a>
          <a href="/sources/" class="depts-anchors__link">Sources open data</a>
        </nav>
      </section>

      {orderedDepts.length > 0 ? (
        <div class="depts-grid" id="depts-grid">
          {orderedDepts.map(d => (
            <a href={`/departement/${d.departement}/`} class="departement-card" aria-label={`Département ${d.nom || d.departement} — ${d.totalEvents} événements`}>
              <span class="departement-card__numero" style={`font-size: clamp(1.2rem, ${getSize(d.totalEvents) * 0.8 + 0.8}rem, 2.2rem)`}>{d.departement}</span>
              <span class="departement-card__nom">{d.nom || `Département ${d.departement}`}</span>
              <span class="departement-card__count">{d.totalEvents.toLocaleString('fr-FR')} événement{d.totalEvents > 1 ? 's' : ''}</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state" role="status">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-neutral-300)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
          <h3>Les données arrivent bientôt</h3>
          <p>Les événements sont en cours de collecte. <a href="/">Retour à l'accueil</a></p>
        </div>
      )}

      <nav class="depts-nav">
        <a href="/" class="depts-nav__link">← Retour à l'accueil</a>
        <a href="/sources/" class="depts-nav__link">Sources open data</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .breadcrumb { background: white; border-bottom: 1px solid var(--color-neutral-100); }
  .breadcrumb__list { display: flex; align-items: center; gap: var(--space-2); list-style: none; padding: var(--space-3) 0; font-size: var(--text-sm); flex-wrap: wrap; }
  .breadcrumb__item { display: flex; align-items: center; gap: var(--space-1); }
  .breadcrumb__link { color: var(--color-neutral-500); text-decoration: none; }
  .breadcrumb__link:hover { color: var(--color-brand-brick); }
  .breadcrumb__item--current span { color: var(--color-neutral-900); font-weight: var(--font-semibold); }
  .breadcrumb__sep { color: var(--color-neutral-300); flex-shrink: 0; }

  .depts-page { padding: var(--space-8) 0 var(--space-12); background: var(--color-neutral-50); }
  .depts-page__header { text-align: center; margin-bottom: var(--space-8); }
  .depts-page__title { font-size: var(--text-3xl); font-family: var(--font-serif); font-weight: var(--font-normal); }
  .depts-page__desc { font-size: var(--text-base); color: var(--color-neutral-500); margin-top: var(--space-2); }

  .depts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--space-3); }
  .departement-card { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-1); padding: var(--space-4) var(--space-3); background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-soft); transition: all var(--transition-default); text-decoration: none; border: 1.5px solid transparent; }
  .departement-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-medium); border-color: var(--color-brand-brick); }
  .departement-card__numero { font-weight: var(--font-bold); color: var(--color-brand-brick); line-height: 1; font-family: var(--font-sans); }
  .departement-card__nom { font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--color-neutral-900); text-align: center; }
  .departement-card__count { font-size: 0.65rem; color: var(--color-brand-muted); }

  .empty-state { display: flex; flex-direction: column; align-items: center; gap: var(--space-4); padding: var(--space-12) var(--space-4); text-align: center; }
  .empty-state h3 { font-size: var(--text-xl); font-weight: var(--font-semibold); color: var(--color-neutral-700); font-family: var(--font-sans); }
  .empty-state p { font-size: var(--text-base); color: var(--color-neutral-500); max-width: 400px; }
  .empty-state a { color: var(--color-brand-brick); font-weight: 600; }

  .depts-nav { display: flex; justify-content: center; gap: var(--space-4); margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--color-neutral-100); }
  .depts-nav__link { font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--color-brand-brick); text-decoration: none; }
  .depts-nav__link:hover { color: #B84E23; text-decoration: underline; }

  /* SEO Intro */
  .depts-seo { margin-bottom: var(--space-6); padding: var(--space-4) var(--space-5); background: white; border-radius: var(--radius-xl); border: 1px solid var(--color-neutral-100); box-shadow: var(--shadow-soft); }
  .depts-seo__text { font-size: var(--text-sm); line-height: var(--leading-relaxed); color: var(--color-neutral-600); max-width: 72ch; }
  .depts-seo__text strong { color: var(--color-neutral-900); }
  .depts-anchors { display: flex; gap: var(--space-3); margin-top: var(--space-3); flex-wrap: wrap; }
  .depts-anchors__link { font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--color-brand-brick); text-decoration: none; padding: var(--space-1) var(--space-3); border-radius: var(--radius-md); background: var(--color-neutral-50); }
  .depts-anchors__link:hover { background: var(--color-brand-brick); color: white; }
</style>