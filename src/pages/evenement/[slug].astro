---
// src/pages/evenement/[slug].astro — Fiche événement
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  let allEvents = [];
  try {
    const { readFileSync, readdirSync } = await import('node:fs');
    const { join } = await import('node:path');
    const dir = join(process.cwd(), 'public', 'data');
    const files = readdirSync(dir).filter(f => f.startsWith('events-') && f.endsWith('.json') && f !== 'events-index.json');
    for (const f of files) {
      allEvents.push(...JSON.parse(readFileSync(join(dir, f), 'utf-8')));
    }
  } catch {}
  if (allEvents.length === 0) return [{ params: { slug: 'placeholder' } }];
  return allEvents.map(e => ({ params: { slug: e.slug || String(e.uid) }, props: { event: e } }));
}

const { event } = Astro.props;
const hasEvent = event && event.titre;
const siteUrl = 'https://sortirici.github.io';
---

<BaseLayout
  title={hasEvent ? `${event.titre} — ${event.lieuCommune || ''} | SortirIci` : 'Événement — SortirIci'}
  description={hasEvent ? (event.descriptionCourte || '').slice(0, 160) : 'Détails de l\'événement'}
  noIndex={!hasEvent}
>
  <div class="container" style="padding: 3rem 1rem;">

    {!hasEvent ? (
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4rem 1rem; text-align: center; background: #F0F0F5; border-radius: 0.75rem;">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#CACADD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 1rem;">
          <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
        </svg>
        <h2 style="font-size: 1.25rem; font-weight: 600; color: #1A1A2E; margin-bottom: 0.5rem;">
          Événement en cours de chargement
        </h2>
        <p style="color: #6A6A8A; max-width: 400px; line-height: 1.5; margin-bottom: 1rem;">
          Les fiches détaillées seront disponibles après le prochain cycle de mise à jour.
        </p>
        <a href="/" style="padding: 0.75rem 2rem; background: #1A5FB4; color: white; border-radius: 0.75rem; text-decoration: none; font-weight: 600;">
          Retour à l'accueil
        </a>
      </div>
    ) : (
      <div>
        <nav aria-label="Fil d'Ariane" style="margin-bottom: 1rem; font-size: 0.875rem; color: #6A6A8A;">
          <a href="/" style="color: #6A6A8A;">Accueil</a>
          <span style="margin: 0 0.5rem;">›</span>
          <a href={`/departement/${event.departementNumero || ''}/`} style="color: #6A6A8A;">
            {event.lieuDepartement || 'Département'}
          </a>
          <span style="margin: 0 0.5rem;">›</span>
          <span style="color: #1A1A2E; font-weight: 600;">{event.titre}</span>
        </nav>

        <h1 style="font-size: 2.25rem; font-weight: 700; margin-bottom: 0.5rem; color: #1A1A2E;">
          {event.titre}
        </h1>

        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
          {event.categorie && (
            <span style="background: #E8F0FA; color: #1A5FB4; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
              {event.categorie}
            </span>
          )}
          {event.gratuit && (
            <span style="background: #E8F5E9; color: #2D7D32; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
              Gratuit
            </span>
          )}
          {event.statut === 'annule' && (
            <span style="background: #FFEBEE; color: #DC2626; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
              Annulé
            </span>
          )}
          <span style="background: #F0F0F5; color: #6A6A8A; padding: 0.25rem 0.75rem; border-radius: 0.5rem; font-size: 0.75rem; font-weight: 500;">
            Source : {event.source || 'open data'}
          </span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding: 1.5rem; background: #F0F0F5; border-radius: 0.75rem; margin-bottom: 1.5rem;">
          <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A5FB4" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
            <div>
              <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #6A6A8A;">Date</div>
              <div style="font-size: 1rem; color: #1A1A2E; font-weight: 500;">
                {new Date(event.dateDebut).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                {event.dateFin && event.dateFin !== event.dateDebut ? ` — ${new Date(event.dateFin).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}` : ''}
              </div>
            </div>
          </div>

          <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A5FB4" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #6A6A8A;">Lieu</div>
              <div style="font-size: 1rem; color: #1A1A2E; font-weight: 500;">
                {event.lieuNom || event.lieuCommune}
                {event.lieuAdresse ? <div style="font-size: 0.875rem; color: #6A6A8A; font-weight: 400;">{event.lieuAdresse}</div> : ''}
              </div>
            </div>
          </div>

          <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A5FB4" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <div>
              <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #6A6A8A;">Tarif</div>
              <div style="font-size: 1rem; color: #1A1A2E; font-weight: 500;">
                {event.gratuit ? 'Gratuit' : (event.prixIndicatif || 'Non renseigné')}
              </div>
            </div>
          </div>

          <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A5FB4" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <div>
              <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #6A6A8A;">Source</div>
              <div style="font-size: 1rem; color: #1A1A2E; font-weight: 500;">
                Licence : {event.licence || 'Licence ouverte'}
                {event.sourceUrl ? <a href={event.sourceUrl} target="_blank" rel="noopener" style="display: block; font-size: 0.875rem; color: #1A5FB4; font-weight: 400;">Voir la source originale ↗</a> : ''}
              </div>
            </div>
          </div>
        </div>

        {event.descriptionCourte && (
          <div style="font-size: 1rem; line-height: 1.75; color: #3A3A5A; max-width: 72ch; margin-bottom: 1.5rem;">
            {event.descriptionCourte}
          </div>
        )}

        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href={`/departement/${event.departementNumero || ''}/`} style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; background: #F0F0F5; color: #1A5FB4; border-radius: 0.75rem; text-decoration: none; font-size: 0.875rem; font-weight: 500;">
            ← Tous les événements dans le {event.lieuDepartement || `département ${event.departementNumero}`}
          </a>
          {event.categorie && (
            <a href={`/departement/${event.departementNumero}/${event.categorie}/`} style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; background: #F0F0F5; color: #1A5FB4; border-radius: 0.75rem; text-decoration: none; font-size: 0.875rem; font-weight: 500;">
              Voir tous les {event.categorie}s →
            </a>
          )}
        </div>
      </div>
    )}

  </div>
</BaseLayout>