---
// src/pages/evenement/[slug].astro — Fiche événement
// Infos structurées + carte + source badge + JSON-LD + maillage sémantique
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  let allEvents: any[] = [];
  try {
    const { readFileSync, readdirSync } = await import('node:fs');
    const { join } = await import('node:path');
    const dir = join(process.cwd(), 'public', 'data');
    const files = readdirSync(dir).filter(f => f.startsWith('events-') && f.endsWith('.json') && f !== 'events-index.json');
    for (const f of files) {
      allEvents.push(...JSON.parse(readFileSync(join(dir, f), 'utf-8')));
    }
  } catch {}
  if (allEvents.length === 0) return [{ params: { slug: 'placeholder' } }];
  return allEvents.map((e: any) => ({ params: { slug: e.slug || String(e.uid) }, props: { event: e } }));
}

const { event } = Astro.props;
if (!event) { throw new Error('Événement introuvable'); }

// Helpers
function formatDateRange(ds: string, de?: string) {
  if (!ds) return '';
  const s = new Date(ds);
  const o: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'long', year: 'numeric' };
  if (!de || ds === de) return s.toLocaleDateString('fr-FR', o);
  return `Du ${s.toLocaleDateString('fr-FR', o)} au ${new Date(de).toLocaleDateString('fr-FR', o)}`;
}

const srcLabels: Record<string, string> = { openagenda: 'OpenAgenda', 'ministere-culture': 'Ministère Culture', mairie: 'Mairie', 'portail-local': 'Portail local' };
const srcInfo = { label: 'open data', style: '#E8F0FA;color:#1A5FB4' };
for (const [k, v] of Object.entries(srcLabels)) {
  if (event.source?.includes(k)) { srcInfo.label = v; break; }
}

const catColors: Record<string, string> = {
  concert:'#E8F0FA;color:#1A5FB4', theatre:'#F3E8FF;color:#7C3AED', exposition:'#FFF3E0;color:#E86C00',
  spectacle:'#FCE4EC;color:#D81B60', festival:'#E8F5E9;color:#2D7D32', cinema:'#FFF8E1;color:#F59E0B',
  danse:'#F3E5F5;color:#8E24AA', cirque:'#FFEBEE;color:#C62828', lecture:'#E0F2F1;color:#00695C',
  conference:'#E3F2FD;color:#1565C0', atelier:'#FFF3E0;color:#E65100', marche:'#E8F5E9;color:#2E7D32',
  foire:'#FFF8E1;color:#F57F17', sport:'#E3F2FD;color:#0D47A1', enfants:'#FCE4EC;color:#AD1457',
};

const siteUrl = 'https://sortirici.github.io';
const pageTitle = `${event.titre} — ${event.lieuCommune || ''} | SortirIci`;
const pageDesc = (event.descriptionCourte || '').slice(0, 160);
const eventUrl = `${siteUrl}/evenement/${event.slug || event.uid}/`;

// JSON-LD
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": `Département ${event.lieuDepartement||''}`, "item": `${siteUrl}/departement/${event.departementNumero||''}/` },
    { "@type": "ListItem", "position": 3, "name": event.titre, "item": eventUrl },
  ],
};
const eventLd: Record<string, any> = {
  "@context": "https://schema.org", "@type": "Event", "name": event.titre,
  "description": event.descriptionCourte || event.titre, "url": eventUrl,
  "startDate": event.dateDebut, "endDate": event.dateFin || undefined,
  "eventStatus": event.statut === 'annule' ? 'https://schema.org/EventCancelled' : 'https://schema.org/EventScheduled',
  "eventAttendanceMode": event.modeAcces === 'en_ligne' ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
  "isAccessibleForFree": event.gratuit || false,
};
if (event.lieuNom || event.lieuCommune) {
  eventLd.location = { "@type": "Place", name: event.lieuNom || event.lieuCommune, address: { "@type": "PostalAddress", streetAddress: event.lieuAdresse || undefined, addressLocality: event.lieuCommune || undefined, postalCode: event.lieuCodePostal || undefined, addressCountry: "FR" } };
  if (event.lieuLatitude && event.lieuLongitude) eventLd.location.geo = { "@type": "GeoCoordinates", latitude: event.lieuLatitude, longitude: event.lieuLongitude };
}
eventLd.organizer = { "@type": "Organization", name: srcInfo.label };
if (event.image) eventLd.image = event.image;
if (event.gratuit) eventLd.offers = { "@type": "Offer", price: "0", priceCurrency: "EUR", availability: "https://schema.org/InStock" };
else if (event.prixIndicatif) eventLd.offers = { "@type": "Offer", price: event.prixIndicatif, priceCurrency: "EUR" };
---

<BaseLayout title={pageTitle} description={pageDesc} canonical={`/evenement/${event.slug || event.uid}/`} jsonLd={[breadcrumbLd, eventLd]} ogImage={event.image || undefined}>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <div class="container">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/" class="breadcrumb__link">Accueil</a><svg class="breadcrumb__sep" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></li>
        <li class="breadcrumb__item"><a href={`/departement/${event.departementNumero||''}/`} class="breadcrumb__link">{event.lieuDepartement || 'Département'}</a><svg class="breadcrumb__sep" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></li>
        <li class="breadcrumb__item breadcrumb__item--current" aria-current="page"><span>{event.titre}</span></li>
      </ol>
    </div>
  </nav>

  <article class="event-detail" itemscope itemtype="https://schema.org/Event">
    <div class="container">
      {event.image && (
        <figure class="event-hero">
          <img src={event.image} alt={`Image de ${event.titre}`} class="event-hero__image" loading="eager" width="1200" height="400" />
          <figcaption class="sr-only">Image illustrative de {event.titre}</figcaption>
        </figure>
      )}

      <div class="event-header">
        <div class="event-header__meta">
          <span class="category-chip" style={event.categorie && catColors[event.categorie] ? `background:${catColors[event.categorie].split(';')[0]};color:${catColors[event.categorie].split('color:')[1]}` : ''}>{event.categorie || 'Événement'}</span>
          {event.gratuit && <span class="badge badge--gratuit">Gratuit</span>}
          {event.statut === 'annule' && <span class="badge badge--annule">Annulé</span>}
        </div>
        <h1 class="event-header__title" itemprop="name">{event.titre}</h1>
        <p class="event-header__subtitle">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          {event.lieuCommune}{event.lieuDepartement ? ` (${event.lieuDepartement})` : ''}
        </p>
      </div>

      <!-- Info Grid -->
      <div class="event-info-grid">
        <div class="event-info-item">
          <svg class="event-info-item__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
          <div><span class="event-info-item__label">Date</span><span class="event-info-item__value" itemprop="startDate" content={event.dateDebut}>{formatDateRange(event.dateDebut, event.dateFin)}</span></div>
        </div>
        {event.horaires && (
          <div class="event-info-item">
            <svg class="event-info-item__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <div><span class="event-info-item__label">Horaires</span><span class="event-info-item__value">{event.horaires}</span></div>
          </div>
        )}
        <div class="event-info-item" itemprop="location" itemscope itemtype="https://schema.org/Place">
          <svg class="event-info-item__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <div><span class="event-info-item__label">Lieu</span><span class="event-info-item__value" itemprop="name">{event.lieuNom || event.lieuCommune}</span>
          {event.lieuAdresse && <span class="event-info-item__sub" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress"><span itemprop="streetAddress">{event.lieuAdresse}</span>{event.lieuCodePostal && <span>, <span itemprop="postalCode">{event.lieuCodePostal}</span></span>}{event.lieuCommune && <span> <span itemprop="addressLocality">{event.lieuCommune}</span></span>}</span>}</div>
        </div>
        <div class="event-info-item">
          <svg class="event-info-item__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v12"/><path d="M16 8.5c-.5-.5-1.5-1-3-1s-3 .5-3 2c0 2 4 2 4 4s-1.5 3-4 3c-1.5 0-2.5-.5-3-1"/></svg>
          <div><span class="event-info-item__label">Tarif</span><span class="event-info-item__value">{event.gratuit ? 'Gratuit' : (event.prixIndicatif || 'Non renseigné')}</span></div>
        </div>
        {event.lieuAccessFr && (
          <div class="event-info-item">
            <svg class="event-info-item__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 18a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v2H2Z"/><path d="M6 12h12"/><path d="M10 4h4"/><path d="M12 12v6"/></svg>
            <div><span class="event-info-item__label">Accès</span><span class="event-info-item__value">{event.lieuAccessFr}</span></div>
          </div>
        )}
        {event.modeAcces && event.modeAcces !== 'sur_place' && (
          <div class="event-info-item">
            <svg class="event-info-item__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            <div><span class="event-info-item__label">Accès</span><span class="event-info-item__value">{event.modeAcces === 'en_ligne' ? 'En ligne' : 'Hybride'}</span></div>
          </div>
        )}
      </div>

      <!-- Description -->
      {(event.descriptionCourte || event.titre) && (
        <div class="event-description">
          <h2 class="sr-only">Description</h2>
          <div class="event-description__content" itemprop="description">{event.descriptionCourte || event.titre}</div>
        </div>
      )}

      <!-- Mini Carte -->
      <div class="event-map-section">
        <h2 class="event-map-section__title">Plan d'accès</h2>
        <div id="event-map" class="map-container map-container--small" aria-label={`Carte de ${event.lieuNom || event.lieuCommune}`} x-data="mapApp()" data-map-type="detail" data-lat={event.lieuLatitude} data-lng={event.lieuLongitude} data-title={event.lieuNom || event.lieuCommune}>
          <noscript><div class="map-fallback">Carte non disponible. <a href={`https://www.openstreetmap.org/?mlat=${event.lieuLatitude}&mlon=${event.lieuLongitude}&zoom=14`} target="_blank" rel="noopener">Voir sur OSM</a></div></noscript>
        </div>
        <a href={`https://www.openstreetmap.org/?mlat=${event.lieuLatitude}&mlon=${event.lieuLongitude}&zoom=15`} target="_blank" rel="noopener" class="map-external-link">Ouvrir dans OpenStreetMap ↗</a>
      </div>

      <!-- Source Badge -->
      <div class="event-source" role="contentinfo" aria-label="Source">
        <div class="event-source__badge" style={`background:${srcInfo.style.split(';')[0]};color:${srcInfo.style.split('color:')[1]};border:1px solid ${srcInfo.style.split(';')[0]}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19a9 3 0 0 0 18 0V5"/></svg>
          <span>Source : {srcInfo.label}</span>
        </div>
        <div class="event-source__info">
          <p><strong>Donnée de confiance</strong> — Cet événement provient d'une source publique open data.</p>
          <p>Licence : <strong>{event.licence || 'Licence ouverte (Etalab)'}</strong></p>
          {event.sourceUrl && <a href={event.sourceUrl} target="_blank" rel="noopener" class="event-source__link">Voir la fiche source originale ↗</a>}
        </div>
      </div>

      <!-- Maillage -->
      <nav class="event-nav" aria-label="Navigation contextuelle">
        <div class="event-nav__links">
          <a href={`/departement/${event.departementNumero || ''}/`} class="event-nav__link">← Tous les événements dans le {event.lieuDepartement || `département ${event.departementNumero}`}</a>
          <a href="/sources/" class="event-nav__link">Découvrir toutes nos sources →</a>
          {event.categorie && <a href={`/departement/${event.departementNumero}/${event.categorie}/`} class="event-nav__link">Voir tous les {event.categorie}s →</a>}
        </div>
      </nav>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .breadcrumb { background: white; border-bottom: 1px solid var(--color-neutral-200); }
  .breadcrumb__list { display: flex; align-items: center; gap: var(--space-2); list-style: none; padding: var(--space-3) 0; font-size: var(--text-sm); flex-wrap: wrap; }
  .breadcrumb__item { display: flex; align-items: center; gap: var(--space-1); }
  .breadcrumb__link { color: var(--color-neutral-500); text-decoration: none; }
  .breadcrumb__link:hover { color: var(--color-brand-blue); }
  .breadcrumb__item--current span { color: var(--color-neutral-900); font-weight: var(--font-semibold); }
  .breadcrumb__sep { color: var(--color-neutral-300); flex-shrink: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  .event-detail { padding: var(--space-6) 0 var(--space-12); }
  .event-hero { margin-bottom: var(--space-6); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-soft); }
  .event-hero__image { width: 100%; height: 360px; object-fit: cover; }
  @media (max-width: 640px) { .event-hero__image { height: 200px; } }

  .event-header { margin-bottom: var(--space-6); }
  .event-header__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3); }
  .event-header__title { font-size: clamp(var(--text-2xl),4vw,var(--text-4xl)); font-weight: var(--font-bold); }
  .event-header__subtitle { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-neutral-500); margin-top: var(--space-2); }
  .badge { display: inline-flex; align-items: center; font-size: var(--text-xs); font-weight: var(--font-semibold); padding: 2px var(--space-2); border-radius: var(--radius-full); }
  .badge--gratuit { background: var(--color-brand-green); color: white; }
  .badge--annule { background: var(--color-error); color: white; }
  .category-chip { display: inline-flex; align-items: center; padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: var(--font-medium); }

  .event-info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); padding: var(--space-6); background: var(--color-neutral-50); border-radius: var(--radius-xl); margin-bottom: var(--space-6); }
  @media (max-width: 640px) { .event-info-grid { grid-template-columns: 1fr; } }
  .event-info-item { display: flex; align-items: flex-start; gap: var(--space-3); }
  .event-info-item__icon { flex-shrink: 0; width: 20px; height: 20px; color: var(--color-brand-blue); margin-top: 2px; }
  .event-info-item__label { display: block; font-size: var(--text-xs); font-weight: var(--font-semibold); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-neutral-400); margin-bottom: 2px; }
  .event-info-item__value { display: block; font-size: var(--text-base); color: var(--color-neutral-900); font-weight: var(--font-medium); }
  .event-info-item__sub { display: block; font-size: var(--text-sm); color: var(--color-neutral-500); margin-top: 2px; }

  .event-description { margin-bottom: var(--space-6); }
  .event-description__content { font-size: var(--text-base); line-height: var(--leading-relaxed); color: var(--color-neutral-700); max-width: 72ch; white-space: pre-line; }

  .event-map-section { margin-bottom: var(--space-6); }
  .event-map-section__title { font-size: var(--text-lg); font-weight: var(--font-semibold); margin-bottom: var(--space-3); }
  .map-container--small { height: 260px; border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-soft); }
  .map-fallback { display: flex; align-items: center; justify-content: center; height: 100%; padding: var(--space-6); text-align: center; background: var(--color-neutral-100); color: var(--color-neutral-500); }
  .map-external-link { display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-sm); color: var(--color-brand-blue); margin-top: var(--space-2); text-decoration: none; }
  .map-external-link:hover { color: var(--color-brand-orange); text-decoration: underline; }

  .event-source { padding: var(--space-4); background: var(--color-neutral-50); border-radius: var(--radius-xl); border: 1px solid var(--color-neutral-200); margin-bottom: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); }
  .event-source__badge { display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-1) var(--space-3); border-radius: var(--radius-md); font-size: var(--text-xs); font-weight: var(--font-medium); white-space: nowrap; width: fit-content; }
  .event-source__info { font-size: var(--text-sm); color: var(--color-neutral-600); line-height: var(--leading-relaxed); }
  .event-source__info p { margin-bottom: var(--space-1); }
  .event-source__link { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--color-brand-blue); font-weight: var(--font-semibold); text-decoration: none; margin-top: var(--space-2); }
  .event-source__link:hover { color: var(--color-brand-orange); text-decoration: underline; }

  .event-nav { padding: var(--space-4) 0; }
  .event-nav__links { display: flex; flex-direction: column; gap: var(--space-3); }
  .event-nav__link { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--color-brand-blue); text-decoration: none; padding: var(--space-2) 0; width: fit-content; }
  .event-nav__link:hover { color: var(--color-brand-orange); text-decoration: underline; }

  @media (prefers-reduced-motion: reduce) { *,*::before,*::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; } }
  [x-cloak] { display: none !important; }
</style>

<script>
document.addEventListener('alpine:init', () => {
  Alpine.data('mapApp', () => ({
    init() {
      const el = this.$el;
      const lat = parseFloat(el.dataset.lat), lng = parseFloat(el.dataset.lng), title = el.dataset.title || 'Lieu';
      if (isNaN(lat) || isNaN(lng)) return;
      const loadMap = () => {
        if (typeof L === 'undefined') {
          const link = document.createElement('link'); link.rel = 'stylesheet'; link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'; document.head.appendChild(link);
          const s = document.createElement('script'); s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'; s.onload = () => initMap(); document.body.appendChild(s);
        } else { initMap(); }
      };
      const initMap = () => {
        const map = L.map(el, { center: [lat, lng], zoom: 14, scrollWheelZoom: false });
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap' }).addTo(map);
        L.marker([lat, lng], { title }).addTo(map).bindPopup(`<strong>${title}</strong><br><a href="https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}&zoom=15" target="_blank" rel="noopener">Voir sur OSM →</a>`).openPopup();
      };
      loadMap();
    },
  }));
});
</script>