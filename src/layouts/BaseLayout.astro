---
// BaseLayout.astro - Layout principal avec SEO, JSON-LD, design tokens (v2)
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, any>;
  noIndex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.svg',
  jsonLd,
  noIndex = false,
} = Astro.props;

const siteUrl = 'https://sortirici.github.io';
const fullCanonical = canonical ? `${siteUrl}${canonical}` : siteUrl;
const fullOgImage = `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={fullCanonical} />
    
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#D45D2E" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="SortirIci" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    
    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    
    <!-- Organisation JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "SortirIci",
      "url": siteUrl,
      "logo": `${siteUrl}/logo.svg`,
      "sameAs": [],
      "description": "L'agenda local de confiance - 100% open data, 0 cookie, 0 tracking"
    })} />
    
    <!-- Favicon & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    
    <!-- Preconnect -->
    <link rel="preconnect" href="https://img.openagenda.com" crossorigin />
    <link rel="preconnect" href="https://data.orleans-metropole.fr" crossorigin />
    
    <!-- Polices auto-hébergées -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/InterVariable.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/DMSerifDisplay-Regular.woff2" crossorigin />
    
    <!-- CSS Global + Design Tokens v2 -->
    <style is:global>
      :root {
        /* Couleurs v2 — palette terre cuite */
        --color-brand-brick: #D45D2E;
        --color-brand-green: #2B7A4B;
        --color-brand-muted: #8A8A9E;
        --color-neutral-900: #1A1A2E;
        --color-neutral-700: #3A3A5A;
        --color-neutral-500: #6B6B7D;
        --color-neutral-300: #B8B8C8;
        --color-neutral-100: #EDEBE3;
        --color-neutral-50: #F7F5F0;
        --color-success: #2B7A4B;
        --color-warning: #F59E0B;
        --color-error: #DC2626;
        
        /* Typographie */
        --font-serif: 'DM Serif Display', Georgia, serif;
        --font-sans: 'Inter Variable', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --text-xs: 0.75rem;
        --text-sm: 0.875rem;
        --text-base: 1rem;
        --text-lg: 1.125rem;
        --text-xl: 1.25rem;
        --text-2xl: 1.5rem;
        --text-3xl: 1.875rem;
        --text-4xl: 2.25rem;
        --font-normal: 400;
        --font-medium: 500;
        --font-semibold: 600;
        --font-bold: 700;
        --leading-tight: 1.25;
        --leading-normal: 1.5;
        --leading-relaxed: 1.75;
        
        /* Espacement */
        --space-0: 0;
        --space-1: 0.25rem;
        --space-2: 0.5rem;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-5: 1.25rem;
        --space-6: 1.5rem;
        --space-8: 2rem;
        --space-10: 2.5rem;
        --space-12: 3rem;
        --space-16: 4rem;
        
        /* Border Radius */
        --radius-sm: 0.375rem;
        --radius-md: 0.5rem;
        --radius-lg: 0.75rem;
        --radius-xl: 1rem;
        --radius-2xl: 1.5rem;
        --radius-full: 9999px;
        --radius-default: 0.75rem;
        
        /* Ombres */
        --shadow-soft: 0 2px 8px rgba(212, 93, 46, 0.08);
        --shadow-medium: 0 4px 16px rgba(212, 93, 46, 0.12);
        --shadow-strong: 0 8px 32px rgba(212, 93, 46, 0.16);
        
        /* Transitions */
        --transition-fast: 100ms ease-out;
        --transition-default: 150ms ease-out;
        --transition-slow: 250ms ease-out;
      }
      
      * { box-sizing: border-box; margin: 0; padding: 0; }
      
      html { 
        font-size: 16px; 
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      
      body {
        font-family: var(--font-sans);
        font-size: var(--text-base);
        line-height: var(--leading-normal);
        color: var(--color-neutral-900);
        background-color: var(--color-neutral-50);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      
      a { color: #B84E23; text-decoration: none; transition: color var(--transition-fast); }
      a:hover { color: #8A3B1A; }
      a:focus-visible { outline: 2px solid #B84E23; outline-offset: 2px; border-radius: 2px; }
      
      img { max-width: 100%; height: auto; display: block; }
      
      /* DM Serif Display pour H1/H2 uniquement */
      h1, h2 { font-family: var(--font-serif); font-weight: var(--font-normal); line-height: var(--leading-tight); color: var(--color-neutral-900); letter-spacing: -0.01em; }
      h3, h4 { font-weight: var(--font-semibold); line-height: var(--leading-tight); color: var(--color-neutral-900); font-family: var(--font-sans); }
      h1 { font-size: var(--text-4xl); }
      h2 { font-size: var(--text-3xl); }
      h3 { font-size: var(--text-2xl); }
      h4 { font-size: var(--text-xl); }
      
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
      
      .container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 var(--space-4); }
      .skip-link { position: absolute; top: -100%; left: 50%; transform: translateX(-50%); background: var(--color-brand-brick); color: white; padding: var(--space-2) var(--space-4); border-radius: var(--radius-md); z-index: 10000; }
      .skip-link:focus { top: var(--space-4); }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>
    
    <header class="site-header" role="banner" style="background: var(--color-neutral-50); border-bottom: 1px solid var(--color-neutral-100);">
      <div class="container">
        <div class="header-content" style="display: flex; align-items: center; justify-content: space-between; padding: var(--space-3) 0; gap: var(--space-4); flex-wrap: wrap;">
          <a href="/" class="site-logo" aria-label="SortirIci - Accueil" style="display: flex; align-items: center; gap: var(--space-2); text-decoration: none; color: var(--color-neutral-900);">
            <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink: 0;">
              <circle cx="16" cy="16" r="14" stroke="var(--color-brand-brick)" stroke-width="2"/>
              <path d="M16 8V16L21 20" stroke="var(--color-brand-brick)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="16" cy="16" r="3" fill="var(--color-brand-green)"/>
            </svg>
            <span style="font-weight: var(--font-bold); font-size: var(--text-lg);">SortirIci</span>
          </a>
          
          <nav class="main-nav" aria-label="Navigation principale" style="display: flex; gap: var(--space-5); flex-wrap: wrap;">
            <a href="/departement/" class="nav-link" style="font-weight: var(--font-medium); font-size: var(--text-sm); color: var(--color-neutral-700);">Départements</a>
            <a href="/sources/" class="nav-link" style="font-weight: var(--font-medium); font-size: var(--text-sm); color: var(--color-neutral-700);">Sources</a>
            <a href="/mentions/" class="nav-link" style="font-weight: var(--font-medium); font-size: var(--text-sm); color: var(--color-neutral-500);">Mentions</a>
          </nav>
        </div>
      </div>
    </header>
    
    <main id="main-content" role="main" style="flex: 1;">
      <slot />
    </main>
    
    <!-- Footer réduit v2 -->
    <footer class="site-footer" role="contentinfo" style="background: var(--color-neutral-900); color: var(--color-neutral-100); padding: var(--space-8) 0 var(--space-4); margin-top: auto;">
      <div class="container">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4);">
          <a href="/" aria-label="SortirIci - Accueil" style="display: flex; align-items: center; gap: var(--space-2); text-decoration: none; color: white;">
            <svg width="24" height="24" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="16" cy="16" r="14" stroke="var(--color-brand-brick)" stroke-width="2"/>
              <path d="M16 8V16L21 20" stroke="var(--color-brand-brick)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="16" cy="16" r="3" fill="var(--color-brand-green)"/>
            </svg>
            <span style="font-weight: var(--font-bold); font-size: var(--text-base);">SortirIci</span>
          </a>
          
          <nav aria-label="Liens utiles" style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
            <a href="/departement/" style="font-size: var(--text-sm); color: var(--color-neutral-300); text-decoration: none;">Départements</a>
            <a href="/sources/" style="font-size: var(--text-sm); color: var(--color-neutral-300); text-decoration: none;">Sources</a>
            <a href="/mentions/" style="font-size: var(--text-sm); color: var(--color-neutral-300); text-decoration: none;">Mentions</a>
          </nav>
        </div>
        <div style="border-top: 1px solid rgba(255,255,255,0.08); margin-top: var(--space-4); padding-top: var(--space-3); text-align: center; font-size: var(--text-xs); color: var(--color-brand-muted);">
          100% open data · 0 cookie · Sources citées · Code MIT
        </div>
      </div>
    </footer>
    
    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
  </body>
</html>